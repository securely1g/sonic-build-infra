load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary")
load("//cc:runtime_test.bzl", "native_runtime_test")
load("//testing:exec_test.bzl", "exec_test")

cc_binary(
    name = "probe",
    srcs = ["probe.cc"],
    linkstatic = False,
    target_compatible_with = ["//platforms:bookworm"],
)

native_runtime_test(
    name = "native_test",
    binary = ":probe",
    runtime_payloads = [
        "@bookworm_toolchains//libc6:data",
        "@bookworm_toolchains//libstdc++6:data",
        "@bookworm_toolchains//libgcc-s1:data",
    ],
    target_compatible_with = ["//platforms:bookworm"],
)

py_binary(
    name = "inspect",
    srcs = ["inspect.py"],
    deps = ["//deb:elf_metadata"],
)

exec_test(
    name = "abi_test",
    runner = ":inspect",
    srcs = [":probe"],
    checker_args = select({
        "@platforms//cpu:x86_64": ["62"],
        "@platforms//cpu:aarch64": ["183"],
    }),
    target_compatible_with = ["//platforms:bookworm"],
)
