load(":binutils_toolchain.bzl", "binutils_binary", "BINUTILS_TOOLS")

licenses(["notice"])

# Binutils that rules need *outside* of a cc action: //binary:strip_binary splits
# an ELF with objcopy, and //binary:assert_stripped reads it back with
# objdump/readelf.
#
# They can't come from the cc toolchain, because CcToolchainInfo exposes objcopy
# but neither readelf nor objdump.
# They can't be plain exec-config label attrs, because we also care that they
# understand the target platform.
#
# The toolchains implementing this type are generated in //:MODULE.bazel
# by gcc.debian_toolchain() tags.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# The toolchain's tools, callable by things that are not rules and so cannot resolve a toolchain themselves
# (e.g. a CI script can use `bazel run @sonic-build-infra//toolchains/binutils:readelf`).
[
    binutils_binary(
        name = tool,
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in BINUTILS_TOOLS
]
