"""Exercise the production archive merger with small test package payloads."""

load("//toolchains/sysroot:merge.bzl", "extract_archives")

def _collision_fixture_impl(ctx):
    result = extract_archives(ctx, ctx.path(ctx.attr.tar), ctx.attr.archives, "root")
    if ctx.attr.expected:
        expected = json.decode(ctx.attr.expected)
        if result != expected:
            fail("Unexpected collision-check counts: {} != {}".format(result, expected))
    ctx.file("collision_check.json", json.encode({
        "_generated": "AUTO-GENERATED by collision_fixture.bzl. DO NOT EDIT MANUALLY.",
        "collision_check": result,
    }) + "\n")
    ctx.file("BUILD.bazel", """# AUTO-GENERATED by collision_fixture.bzl. DO NOT EDIT MANUALLY.
exports_files(["collision_check.json"])
""")

collision_fixture = repository_rule(
    implementation = _collision_fixture_impl,
    attrs = {
        "archives": attr.label_list(mandatory = True, allow_files = [".xz"]),
        "expected": attr.string(),
        "tar": attr.label(mandatory = True, allow_single_file = True),
    },
)
