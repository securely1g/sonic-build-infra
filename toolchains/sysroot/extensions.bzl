"""Expose SONiC's existing Debian sysroot as repository source data."""

load(":merge.bzl", "extract_archives")
load(":packages.bzl", "DEBIAN_SUITES", "sysroot_source_archives")

_NOTICE = "# AUTO-GENERATED by //toolchains/sysroot:extensions.bzl. DO NOT EDIT MANUALLY.\n"

def _relocate_linker_scripts(ctx, architecture):
    # Sandbox inputs are individual symlinks. GNU ld can therefore resolve a
    # script outside the apparent --sysroot and treat its absolute paths as
    # host files. Both GNU ld and LLD support =/path to require sysroot lookup.
    multiarch = {"amd64": "x86_64-linux-gnu", "arm64": "aarch64-linux-gnu"}[architecture]
    relocated = {}
    for name in ["libc.so", "libm.so", "libm.a"]:
        relative = "usr/lib/{}/{}".format(multiarch, name)
        script = ctx.path("root/" + relative)
        original = ctx.read(script)

        # Bookworm ARM64 libm.so is an ELF alias and libm.a is an archive;
        # only GNU linker scripts contain host-root path operands.
        if original.startswith(json.decode('"\\u007fELF"')) or original.startswith("!<arch>\n"):
            continue
        tokens = original.replace("\n", " ").replace("\t", " ").split(" ")
        paths = [token for token in tokens if token.startswith(("/lib/", "/lib64/", "/usr/lib/"))]
        if not paths:
            fail("Expected absolute library inputs in pinned linker script " + relative)
        updated = original
        for path in paths:
            if not ctx.path("root" + path).exists:
                fail("Linker script {} refers to missing sysroot input {}".format(relative, path))
            updated = updated.replace(path, "=" + path)
        notice = "/* AUTO-GENERATED by sonic-build-infra toolchains/sysroot/extensions.bzl. DO NOT EDIT MANUALLY. */\n"
        ctx.file("root/" + relative, notice + updated, executable = False)
        relocated[relative] = paths
    return relocated

def _sysroot_impl(ctx):
    ctx.file("BUILD.bazel", _NOTICE + 'exports_files(["inputs.json"])\n')
    ctx.file("root/BUILD.bazel", _NOTICE + """load("@bazel_skylib//rules/directory:directory.bzl", "directory")

# Declare each file for Bazel's C++ header checking and sandbox input tracking.
# DirectoryInfo points at this same source tree; it does not copy the sysroot.
directory(
    name = "sysroot",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)
""")
    host_arch = {"amd64": "amd64", "x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(ctx.os.arch)
    if ctx.os.name.lower() != "linux" or not host_arch:
        fail("SONiC sysroot creation requires a Linux AMD64 or ARM64 executor")
    tar = ctx.path(getattr(ctx.attr, "_tar_" + host_arch))
    collision_check = extract_archives(ctx, tar, ctx.attr.archives, "root", relocate_root_symlinks = ctx.attr.suite == "bookworm")

    # Debian Trixie uses merged /usr. Its linker scripts must reach these same
    # declared files through /lib and /lib64 as well as /usr/lib.
    links = []
    for directory in ["bin", "sbin", "lib", "lib64"]:
        destination = ctx.path("root/usr/" + directory)
        if destination.exists and not ctx.path("root/" + directory).exists:
            links.append("./{} type=link link=usr/{} uid=0 gid=0 mode=0777 time=0".format(directory, directory))

    # repository_ctx.symlink records an absolute host path. Use the already
    # pinned BSD tar tool to encode relative links, then Bazel's extractor to
    # materialize them. Nothing in the sysroot points at a workspace location.
    ctx.file("links.mtree", "#mtree\n" + _NOTICE + "\n".join(links) + "\n")
    result = ctx.execute([str(tar), "--create", "--format=ustar", "--file", "links.tar", "@links.mtree"])
    if result.return_code:
        fail("Unable to create merged-/usr links: " + result.stderr)
    ctx.extract("links.tar", output = "root")
    ctx.delete("links.tar")
    ctx.delete("links.mtree")

    linker_scripts = {}
    for architecture in ctx.attr.architectures:
        linker_scripts.update(_relocate_linker_scripts(ctx, architecture))

    ctx.file("inputs.json", json.encode_indent({
        "_generated": {
            "notice": "AUTO-GENERATED. DO NOT EDIT MANUALLY.",
            "generator": "sonic-build-infra//toolchains/sysroot:extensions.bzl",
        },
        "architectures": ctx.attr.architectures,
        "collision_check": collision_check,
        "suite": ctx.attr.suite,
        "archives": [str(label) for label in ctx.attr.archives],
        "linker_scripts": linker_scripts,
    }) + "\n")

_sysroot = repository_rule(
    implementation = _sysroot_impl,
    attrs = {
        "archives": attr.label_list(mandatory = True, allow_files = [".xz"]),
        "suite": attr.string(mandatory = True),
        "architectures": attr.string_list(default = ["amd64", "arm64"]),
        "_tar_amd64": attr.label(default = "@bsd_tar_toolchains_linux_amd64//:tar", allow_single_file = True),
        "_tar_arm64": attr.label(default = "@bsd_tar_toolchains_linux_arm64//:tar", allow_single_file = True),
    },
)

def _sysroots_impl(ctx):
    declared = {}
    for module in ctx.modules:
        for tag in module.tags.debian:
            if not tag.architectures or len(depset(tag.architectures).to_list()) != len(tag.architectures) or any([architecture not in ["amd64", "arm64"] for architecture in tag.architectures]):
                fail("Sysroot architectures must be a nonempty unique selection of amd64 and arm64")
            settings = (tag.suite, tag.architectures)
            if tag.name in declared:
                if declared[tag.name] != settings:
                    fail("Conflicting suite for sysroot {}".format(tag.name))

                # Older consumers may repeat the default declaration. Reuse
                # the same repository instead of creating a second tree.
                continue
            declared[tag.name] = settings
            _sysroot(
                name = tag.name,
                suite = tag.suite,
                architectures = tag.architectures,
                archives = [archive for architecture in tag.architectures for archive in sysroot_source_archives(tag.suite, architecture)],
            )

sysroots = module_extension(
    implementation = _sysroots_impl,
    tag_classes = {
        "debian": tag_class(attrs = {
            "name": attr.string(mandatory = True),
            "suite": attr.string(default = "trixie", values = sorted(DEBIAN_SUITES)),
            "architectures": attr.string_list(default = ["amd64", "arm64"]),
        }),
    },
)
