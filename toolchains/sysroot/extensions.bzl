"""Expose SONiC's existing Debian sysroot as repository source data."""

load("//toolchains/gcc:extensions.bzl", "DEBIAN_SUITES", "sysroot_source_archives")

_NOTICE = "# AUTO-GENERATED by //toolchains/sysroot:extensions.bzl. DO NOT EDIT MANUALLY.\n"

def _sysroot_impl(ctx):
    ctx.file("BUILD.bazel", _NOTICE + 'exports_files(["inputs.json"])\n')
    ctx.file("root/BUILD.bazel", _NOTICE + """filegroup(
    name = "sysroot",
    srcs = ["."],
    visibility = ["//visibility:public"],
)
""")
    for label in ctx.attr.archives:
        archive = ctx.path(label)
        if not archive.exists or archive.is_dir or archive.basename != "data.tar.xz":
            fail("Expected pinned Distroless repository source archive: {}".format(label))
        ctx.extract(archive, output = "root")

    # Debian Trixie uses merged /usr. Absolute paths in its linker scripts are
    # interpreted relative to --sysroot and must reach these same declared files.
    links = []
    for directory in ["bin", "sbin", "lib", "lib64"]:
        destination = ctx.path("root/usr/" + directory)
        if destination.exists and not ctx.path("root/" + directory).exists:
            links.append("./{} type=link link=usr/{} uid=0 gid=0 mode=0777 time=0".format(directory, directory))

    # repository_ctx.symlink records an absolute host path. Use the already
    # pinned BSD tar tool to encode relative links, then Bazel's extractor to
    # materialize them. Nothing in the sysroot points at a workspace location.
    host_arch = {"amd64": "amd64", "x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(ctx.os.arch)
    if ctx.os.name.lower() != "linux" or not host_arch:
        fail("SONiC sysroot creation requires a Linux AMD64 or ARM64 executor")
    tar = ctx.path(getattr(ctx.attr, "_tar_" + host_arch))
    ctx.file("links.mtree", "#mtree\n" + _NOTICE + "\n".join(links) + "\n")
    result = ctx.execute([str(tar), "--create", "--format=ustar", "--file", "links.tar", "@links.mtree"])
    if result.return_code:
        fail("Unable to create merged-/usr links: " + result.stderr)
    ctx.extract("links.tar", output = "root")
    ctx.delete("links.tar")
    ctx.delete("links.mtree")

    ctx.file("inputs.json", json.encode_indent({
        "_generated": {
            "notice": "AUTO-GENERATED. DO NOT EDIT MANUALLY.",
            "generator": "sonic-build-infra//toolchains/sysroot:extensions.bzl",
        },
        "architecture": ctx.attr.architecture,
        "suite": ctx.attr.suite,
        "archives": [str(label) for label in ctx.attr.archives],
    }) + "\n")

_sysroot = repository_rule(
    implementation = _sysroot_impl,
    attrs = {
        "archives": attr.label_list(mandatory = True, allow_files = [".xz"]),
        "architecture": attr.string(mandatory = True),
        "suite": attr.string(mandatory = True),
        "_tar_amd64": attr.label(default = "@bsd_tar_toolchains_linux_amd64//:tar", allow_single_file = True),
        "_tar_arm64": attr.label(default = "@bsd_tar_toolchains_linux_arm64//:tar", allow_single_file = True),
    },
)

def _sysroots_impl(ctx):
    for module in ctx.modules:
        for tag in module.tags.debian:
            _sysroot(
                name = tag.name,
                architecture = tag.architecture,
                suite = tag.suite,
                archives = sysroot_source_archives(tag.suite, tag.architecture),
            )

sysroots = module_extension(
    implementation = _sysroots_impl,
    tag_classes = {
        "debian": tag_class(attrs = {
            "name": attr.string(mandatory = True),
            "architecture": attr.string(mandatory = True, values = ["amd64", "arm64"]),
            "suite": attr.string(default = "trixie", values = sorted(DEBIAN_SUITES)),
        }),
    },
)
