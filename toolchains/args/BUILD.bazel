load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

cc_args(
    name = "warnings",
    actions = [
        "@rules_cc//cc/toolchains/actions:c_compile",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
    ],
    args = [
        "-Wall",
        "-Wextra",
        # "-Wpedantic",
    ],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "no_absolute_paths_for_builtins",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
    ],
    args = [
        "-no-canonical-prefixes",
        "-fno-canonical-system-headers",
    ],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "target",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = select({
        "//toolchains/constraint:linux_aarch64": ["--target=aarch64-unknown-linux-gnu"],
        "//toolchains/constraint:linux_x86_64": ["--target=x86_64-linux-gnu"],
    }),
    visibility = ["//visibility:public"],
)

# dpkg-buildflags hands these flags to every Debian package build,
# so we have to replicate them in this toolchain.
cc_args(
    name = "dpkg_buildflags",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
    ],
    args = [
        "-fstack-protector-strong",
        "-fstack-clash-protection",
        "-fcf-protection",
        "-Wformat",
        "-Werror=format-security",
        # Inert without optimisation, and glibc warns when it is missing.
        "-O2",
        "-D_FORTIFY_SOURCE=2",
    ],
    visibility = ["//visibility:public"],
)

cc_args(
    name = "dpkg_buildflags_link",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-Wl,-z,relro",
        "-Wl,-z,now",
    ],
    visibility = ["//visibility:public"],
)

# A binary gets a DT_NEEDED entry for every library on its link line.
# Bazel puts a target's whole transitive dependency set there.
# --as-needed keeps only the libraries we need.
cc_args(
    name = "as_needed",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-Wl,--as-needed",
    ],
    visibility = ["//visibility:public"],
)
