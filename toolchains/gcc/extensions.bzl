"""The `gcc` module extension.

Builds toolchains from pinned Debian GCC packages and the shared sysroot.

By building the sysroots with the same Debian-distributed packages as SONiC,
we can get closer to SONiC's build environment.

This extension defines one tag, `debian_toolchain`,
which defines GCC and binutils for one compiler version, execution/target
architecture pair and Debian suite.

It also defines an auxiliary repo, `@gcc_toolchains`, for easy toolchain installation.
"""

load("//toolchains/sysroot:packages.bzl", "DEBIAN_SUITES")
load(":debian.bzl", "debian_gcc")
load(":gcc.bzl", "GCC_METADATA", "gcc_repo_name")

# The repo the toolchains are generated into.
_TOOLCHAINS_REPO = "gcc_toolchains"

_GCC_DEFS = Label("//toolchains/gcc:defs.bzl")
_BINUTILS_DEFS = Label("//toolchains/binutils:defs.bzl")

_BUILD_HEADER = """# AUTO-GENERATED by //toolchains/gcc:extensions.bzl. DO NOT EDIT MANUALLY.
#
# One cc toolchain and one binutils toolchain per gcc.debian_toolchain() tag in
# //:MODULE.bazel. To change any of these, edit the tag that declares them.

load({binutils_defs}, "sonic_binutils_toolchain")
load({gcc_defs}, "sonic_host_toolchain")
"""

_BUILD_TOOLCHAIN = """
sonic_host_toolchain(
    name = {cc_name},
    cpu = {cpu},
    suite = {suite},
    exec_cpu = {exec_cpu},
    tool_prefix = {tool_prefix},
    debian_gcc_major = {debian_gcc_major},
    sysroot = {sysroot},
    target_platform = {target_platform},
    version = {version},
    visibility = ["//visibility:public"],
)

sonic_binutils_toolchain(
    name = {binutils_name},
    target_platform = {target_platform},
    cpu = {cpu},
    suite = {suite},
    exec_cpu = {exec_cpu},
    tool_prefix = {tool_prefix},
    version = {version},
    visibility = ["//visibility:public"],
)
"""

_ACCEPTED_TOOLCHAIN_KINDS = ["gcc", "binutils"]

def _toolchain_name(cpu, kind, version, exec_cpu = None, suite = "trixie"):
    """The name of the generated `toolchain()` target for a tag.

    Args:
        cpu: the `@platforms//cpu` value, e.g. `x86_64`.
        kind: `gcc` or `binutils`.
        version: the GCC version, e.g. `14.2.0`.
        exec_cpu: Architecture running the tools; defaults to cpu.

    Returns:
        The target name, e.g. `host_x86_64_gcc_14.2.0`.
    """
    if kind not in _ACCEPTED_TOOLCHAIN_KINDS:
        fail("Unknown `kind` in _toolchain_name: {kind}. Accepted kinds {accepted}".format(
            kind = kind,
            accepted = _ACCEPTED_TOOLCHAIN_KINDS,
        ))
    host = exec_cpu or cpu
    prefix = "host_" + host
    if host != cpu:
        prefix += "_target_" + cpu
    return "{prefix}_{kind}_{version}".format(prefix = prefix, kind = kind, version = version) + ("_" + suite if suite != "trixie" else "")

def _gcc_toolchains_impl(rctx):
    build = [_BUILD_HEADER.format(
        binutils_defs = repr(str(_BINUTILS_DEFS)),
        gcc_defs = repr(str(_GCC_DEFS)),
    )]

    for toolchain in json.decode(rctx.attr.toolchains):
        build.append(_BUILD_TOOLCHAIN.format(
            binutils_name = repr(_toolchain_name(toolchain["cpu"], "binutils", toolchain["version"], toolchain["exec_cpu"], toolchain["suite"])),
            cc_name = repr(_toolchain_name(toolchain["cpu"], "gcc", toolchain["version"], toolchain["exec_cpu"], toolchain["suite"])),
            cpu = repr(toolchain["cpu"]),
            suite = repr(toolchain["suite"]),
            exec_cpu = repr(toolchain["exec_cpu"]),
            tool_prefix = repr(toolchain["tool_prefix"]),
            debian_gcc_major = repr(toolchain["debian_gcc_major"]),
            sysroot = repr(toolchain["sysroot"]),
            target_platform = repr(toolchain["target_platform"]),
            version = repr(toolchain["version"]),
        ))

    rctx.file("BUILD.bazel", "".join(build))

_gcc_toolchains = repository_rule(
    implementation = _gcc_toolchains_impl,
    doc = "Declares the cc and binutils toolchains the debian_toolchain() tags ask for.",
    attrs = {
        "toolchains": attr.string(
            doc = "The tags as JSON: a list of objects carrying `cpu`, " +
                  "`exec_cpu`, `tool_prefix`, `version`, `debian_gcc_major`, `sysroot`, " +
                  "and `target_platform`. JSON because repo " +
                  "rule attrs cannot hold nested dicts.",
            mandatory = True,
        ),
    },
)

def _gcc_impl(mctx):
    # Native and cross distributions may target the same architecture.
    toolchains = {}
    for module in mctx.modules:
        for tag in module.tags.debian_toolchain:
            key = (tag.suite, tag.version, tag.arch, tag.exec_arch or tag.arch)
            if key in toolchains:
                fail("gcc.debian_toolchain() has duplicate version/target/exec: {}".format(key))
            toolchains[key] = tag

    if not toolchains:
        fail("the gcc extension needs at least one debian_toolchain() tag")

    for (suite, version, cpu, exec_cpu), tag in toolchains.items():
        prefix = tag.tool_prefix or GCC_METADATA[cpu].multiarch
        if version != DEBIAN_SUITES[suite].compiler_version or prefix != GCC_METADATA[cpu].multiarch:
            fail("Debian package toolchains require the declared suite GCC version and target Debian multiarch prefix")
        if cpu != exec_cpu and (exec_cpu, cpu) != ("x86_64", "aarch64"):
            fail("Supported Debian package toolchains are AMD64 native, ARM64 native and AMD64-to-ARM64")
        if not tag.debian_packages:
            fail("Pinned Debian compiler and execution-runtime packages are required")
        debian_gcc(
            name = gcc_repo_name(cpu, version, exec_cpu, suite),
            suite = suite,
            gcc_major = DEBIAN_SUITES[suite].gcc_major,
            packages = tag.debian_packages,
            target_arch = cpu,
            exec_arch = exec_cpu,
        )

    # One repo holds every toolchain, so that //:MODULE.bazel imports and
    # registers a single repo however many tags it declares.
    _gcc_toolchains(
        name = _TOOLCHAINS_REPO,
        toolchains = json.encode([
            {
                "cpu": cpu,
                "suite": suite,
                "exec_cpu": exec_cpu,
                "tool_prefix": tag.tool_prefix or GCC_METADATA[cpu].gcc,
                "debian_gcc_major": DEBIAN_SUITES[tag.suite].gcc_major,
                "sysroot": str(tag.sysroot),
                "target_platform": str(tag.target_platform),
                "version": version,
            }
            for (suite, version, cpu, exec_cpu), tag in toolchains.items()
        ]),
    )

debian_toolchain = tag_class(
    doc = "Declares a GCC execution/target pair against the SONiC Debian sysroot.",
    attrs = {
        "arch": attr.string(
            doc = "Target `@platforms//cpu`, e.g. `aarch64`.",
            mandatory = True,
            values = sorted(GCC_METADATA),
        ),
        "exec_arch": attr.string(
            doc = "Architecture running the compiler. Defaults to arch for native builds.",
            values = [""] + sorted(GCC_METADATA),
        ),
        "debian_packages": attr.label_list(
            doc = "Pinned Debian compiler and execution-runtime data.tar.xz archives.",
            mandatory = True,
        ),
        "tool_prefix": attr.string(
            doc = "Target triple used by compiler binaries and private directories; defaults to the Debian multiarch prefix.",
        ),
        "target_platform": attr.label(
            doc = "The constraint_value() marking the environment this " +
                  "toolchain's output is deployed to, e.g. //platforms:trixie. " +
                  "Allows differentiating this toolchain from other toolchains for Linux x86, for instance.",
            mandatory = True,
        ),
        "version": attr.string(
            doc = "The GCC version we compile with, e.g. `14.2.0`. Together " +
                  "with `arch` and `exec_arch` it identifies the tag, so declaring a second " +
                  "version for an architecture means a second tag.",
            mandatory = True,
        ),
        "sysroot": attr.label(
            doc = "Shared repository sysroot, also usable by Clang (//root:sysroot).",
            mandatory = True,
        ),
        "suite": attr.string(
            doc = "The Debian suite whose sysroot this toolchain compiles against.",
            mandatory = True,
            values = sorted(DEBIAN_SUITES),
        ),
    },
)

gcc = module_extension(
    implementation = _gcc_impl,
    doc = "Fetches the GCC distributions and declares the toolchains built from them.",
    tag_classes = {
        "debian_toolchain": debian_toolchain,
    },
)
