"""Assemble native and cross Debian GCC executables with their execution runtime."""

load("//toolchains/sysroot:merge.bzl", "extract_archives")
load(":gcc.bzl", "GCC_METADATA")

_NOTICE = "# AUTO-GENERATED by //toolchains/gcc:debian.bzl. DO NOT EDIT MANUALLY.\n"

def _launcher(ctx, path, executable, root_relative, layout, driver = False, archiver = False, delegate = None):
    # Only shell builtins bootstrap the declared loader. Each subprocess gets
    # its own launcher, so LD_LIBRARY_PATH never leaks into generated programs.
    script = """#!/bin/sh
{notice}set -eu
self=$0
case "$self" in /*) ;; *) self="$PWD/$self" ;; esac
root=$(CDPATH= cd -- "${{self%/*}}/{relative}" && pwd -P)
if [ ! -f "$root/inputs.json" ]; then
    runfiles="$self.runfiles"
    if [ ! -d "$runfiles" ]; then
        runfiles=$self
        while :; do
            case "$runfiles" in
                *.runfiles) break ;;
                /|"") echo "Missing Debian compiler runfiles for $self" >&2; exit 1 ;;
            esac
            runfiles=${{runfiles%/*}}
        done
    fi
    root="$runfiles/{repository}"
fi
""".format(
        notice = _NOTICE,
        relative = root_relative,
        repository = ctx.name,
    )
    if delegate:
        # Repository names are canonical in both action sandboxes and runfiles.
        # The selected tool's own launcher supplies its execution libraries.
        delegated_path = "/".join([delegate.workspace_name] + ([delegate.package] if delegate.package else []) + [delegate.name])
        script += 'exec "$root/../' + delegated_path + '" "$@"\n'
        ctx.file(path, script, executable = True)
        return

    script += """unset LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT
COMPILER_PATH="$root/{triple}/bin"
GCC_EXEC_PREFIX="$root/usr/lib/{gcc_directory}/"
export COMPILER_PATH GCC_EXEC_PREFIX
exec "$root/{loader}" \
    --inhibit-cache --library-path "{library_paths}" \
    "$root/{executable}" {options}"$@"
""".format(
        executable = executable,
        triple = layout.triple,
        gcc_directory = layout.gcc_directory,
        loader = layout.loader,
        library_paths = ":".join(["$root/" + path for path in layout.library_paths]),
        options = ('-ffile-prefix-map="$PWD"=. -B "$root/' + layout.triple + '/bin/" ' if driver else '-B "$root/' + layout.libexec + '/" ' if archiver else ""),
    )
    ctx.file(path, script, executable = True)

def _debian_gcc_impl(ctx):
    host_arch = {"amd64": "amd64", "x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(ctx.os.arch)
    if ctx.os.name.lower() != "linux" or not host_arch:
        fail("Debian compiler assembly requires a Linux AMD64 or ARM64 host")
    if bool(ctx.attr.linker) != bool(ctx.attr.linker_files):
        fail("A delegated linker requires both its executable and support files")
    if ctx.attr.linker and (not ctx.attr.linker.workspace_name or not ctx.path(ctx.attr.linker).exists):
        fail("The delegated linker must name an exported source-file launcher in an external repository")
    tar = ctx.path(getattr(ctx.attr, "_tar_" + host_arch))
    collisions = extract_archives(ctx, tar, ctx.attr.packages, ".", relocate_root_symlinks = ctx.attr.suite == "bookworm")

    target = GCC_METADATA[ctx.attr.target_arch]
    execution = GCC_METADATA[ctx.attr.exec_arch]
    gcc_directory = "gcc" if ctx.attr.target_arch == ctx.attr.exec_arch else "gcc-cross"
    major = ctx.attr.gcc_major
    old_layout = ctx.attr.suite == "bookworm"
    layout = struct(
        triple = target.multiarch,
        gcc_directory = gcc_directory,
        libexec = "usr/{}/{}/{}/{}".format("lib" if old_layout else "libexec", gcc_directory, target.multiarch, major),
        loader = "{}/{}/{}".format("lib" if old_layout else "usr/lib", execution.multiarch, execution.dynamic_linker.split("/")[-1]),
        library_directory = "usr/lib/" + execution.multiarch,
        library_paths = ["usr/lib/" + execution.multiarch] + (["lib/" + execution.multiarch] if old_layout else []),
    )

    tools = {
        "gcc": "usr/bin/" + layout.triple + "-gcc-" + major,
        "g++": "usr/bin/" + layout.triple + "-g++-" + major,
        "gcc-ar": "usr/bin/" + layout.triple + "-gcc-ar-" + major,
    }
    for tool in ["ar", "as", "ld", "nm", "objcopy", "objdump", "ranlib", "readelf", "strip"]:
        tools[tool] = "usr/bin/" + layout.triple + "-" + tool
    for tool in ["cc1", "cc1plus", "collect2", "lto1", "lto-wrapper"]:
        tools[tool] = layout.libexec + "/" + tool
    for tool, executable in tools.items():
        if not ctx.path(executable).exists:
            fail("Pinned Debian compiler packages are missing " + executable)

        # gcc-ar needs explicit search directories for its LTO plugin and
        # archiver when its executable is started through the private loader.
        delegate = ctx.attr.linker if tool == "ld" else None
        _launcher(ctx, "bin/" + layout.triple + "-" + tool, executable, "..", layout, tool in ["gcc", "g++"], tool == "gcc-ar", delegate)
        _launcher(ctx, layout.triple + "/bin/" + tool, executable, "../..", layout, tool in ["gcc", "g++"], tool == "gcc-ar", delegate)

    # gcc-ar accepts one -B directory for both its plugin and archiver.
    _launcher(ctx, layout.libexec + "/ar", tools["ar"], "../../../../..", layout)

    inputs = {
        "_generated": {"notice": "AUTO-GENERATED. DO NOT EDIT MANUALLY.", "generator": "sonic-build-infra//toolchains/gcc:debian.bzl"},
        "format_version": 1,
        "execution_architecture": execution.deb,
        "target_architecture": target.deb,
        "packages": [{"archive": str(label)} for label in ctx.attr.packages],
        "tools": tools,
        "loader": layout.loader,
        "library_directories": layout.library_paths,
        "suite": ctx.attr.suite,
        "gcc_major": major,
        "collision_check": collisions,
    }
    if ctx.attr.linker:
        inputs["linker_override"] = {
            "executable": str(ctx.attr.linker),
            "support_files": str(ctx.attr.linker_files),
        }
    ctx.file("inputs.json", json.encode_indent(inputs) + "\n", executable = False)
    ctx.template(
        "BUILD.bazel",
        ctx.attr._build_file_template,
        substitutions = {
            "{triple}": layout.triple,
            "{linker_files}": repr([str(ctx.attr.linker), str(ctx.attr.linker_files)] if ctx.attr.linker else []),
        },
        executable = False,
    )

debian_gcc = repository_rule(
    implementation = _debian_gcc_impl,
    attrs = {
        "suite": attr.string(default = "trixie", values = ["trixie", "bookworm"]),
        "gcc_major": attr.string(default = "14"),
        "packages": attr.label_list(mandatory = True, allow_files = [".xz"]),
        "linker": attr.label(allow_single_file = True),
        "linker_files": attr.label(),
        "target_arch": attr.string(mandatory = True, values = sorted(GCC_METADATA)),
        "exec_arch": attr.string(mandatory = True, values = sorted(GCC_METADATA)),
        "_build_file_template": attr.label(default = Label("//toolchains/gcc:gcc.BUILD"), allow_single_file = True),
        "_tar_amd64": attr.label(default = "@bsd_tar_toolchains_linux_amd64//:tar", allow_single_file = True),
        "_tar_arm64": attr.label(default = "@bsd_tar_toolchains_linux_arm64//:tar", allow_single_file = True),
    },
)
