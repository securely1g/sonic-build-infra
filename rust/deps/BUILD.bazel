package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# Public names point to one generated crate graph for every consumer.
# Add ordinary direct dependencies to this list; keep versioned exceptions explicit.
_DIRECT_CRATES = [
    "ahash",
    "async-trait",
    "bindgen",
    "byteorder",
    "chrono",
    "clap",
    "color-eyre",
    "criterion",
    "env_logger",
    "futures-timer",
    "genetlink",
    "getset",
    "injectorpp",
    "lazy_static",
    "libc",
    "log",
    "mio",
    "netlink-packet-core",
    "netlink-packet-generic",
    "netlink-packet-utils",
    "netlink-sys",
    "nix",
    "once_cell",
    "opentelemetry",
    "opentelemetry-http",
    "opentelemetry-otlp",
    "opentelemetry-proto",
    "opentelemetry-semantic-conventions",
    "opentelemetry-stdout",
    "opentelemetry_sdk",
    "paste",
    "prost",
    "prost-types",
    "rand",
    "reqwest",
    "reqwest-middleware",
    "reqwest-tracing",
    "scopeguard",
    "serde",
    "serde_json",
    "serde_yaml",
    "serial_test",
    "syslog-tracing",
    "tempfile",
    "thiserror",
    "tokio",
    "tokio-stream",
    "tonic",
    "tonic-health",
    "tracing",
    "tracing-log",
    "tracing-opentelemetry",
    "tracing-subscriber",
    "wait-timeout",
    "which",
]

[
    alias(
        name = name,
        actual = "@crates//:" + name,
    )
    for name in _DIRECT_CRATES
]

# serde_core is transitive in Cargo, so rules_rs exposes its versioned name.
alias(
    name = "serde_core",
    actual = "@crates//:serde_core-1.0.228",
)
