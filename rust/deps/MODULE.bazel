module(
    name = "sonic-rust-deps",
    version = "0.0.4",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "1.8.0")

# Apply the owned compatibility fix through rules_rs's public patch API.
rules_rust_patches = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
rules_rust_patches.patch(
    patches = ["//patches:rules-rust-elf-libraries.patch"],
    strip = 1,
)
use_repo(rules_rust_patches, "rules_rust")
bazel_dep(name = "platforms", version = "1.1.0")

# Keep a pinned toolchain available to standalone and fresh registry consumers.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Common and SWSS depend directly on this module's public crate targets.
# rules_rs reads the tracked Cargo inputs directly, including for dependencies.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "sonic_rust_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    use_legacy_rules_rust_platforms = True,
)
use_repo(crate, crates = "sonic_rust_crates")
