Subject: [PATCH] Ignore whitespace-only pkg-config arguments

Source: https://github.com/bazel-contrib/rules_distroless/blob/v0.9.4/apt/private/pkgconfig.bzl
Origin: SONiC-maintained compatibility fix against the source above.
Reason: Debian Abseil .pc files contain repeated spaces. Empty Libs tokens
become empty linker input filenames and prevent gRPC/DASH clients from linking.
Normalize tabs and ignore empty tokens for Libs, Libs.private and Cflags.
The original parser attribution remains intact.

--- a/apt/private/pkgconfig.bzl
+++ b/apt/private/pkgconfig.bzl
@@ -70,6 +70,9 @@
 def _trim(str):
     return str.rstrip(" ").lstrip(" ")
 
+def _tokens(value):
+    return [token for token in value.replace("\t", " ").split(" ") if token]
+
 def process_pcconfig(pc):
     (directives, variables) = pc
     includedir = ""
@@ -94,7 +97,7 @@
     ]
 
     if "Libs" in directives:
-        libs = _trim(directives["Libs"]).split(" ")
+        libs = _tokens(directives["Libs"])
         for arg in libs:
             if arg.startswith("-L"):
                 linkpath = arg.removeprefix("-L")
@@ -113,7 +116,7 @@
             linkopts.append(arg)
 
     if "Libs.private" in directives:
-        libs = _trim(directives["Libs.private"]).split(" ")
+        libs = _tokens(directives["Libs.private"])
         for arg in libs:
             if arg in IGNORE:
                 continue
@@ -123,7 +126,7 @@
                 libnames.append("lib" + arg.removeprefix("-l"))
 
     if "Cflags" in directives:
-        cflags = _trim(directives["Cflags"]).split(" ")
+        cflags = _tokens(directives["Cflags"])
         for flag in cflags:
             if flag.startswith("-I"):
                 include = flag.removeprefix("-I")
