From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH] Export original pkg-config files as declared package inputs

Source: bazel-contrib/rules_distroless v0.9.4 (b9da1141985c4a84f696326006e0d85659c40747).
IpRoute2's configure script asks pkgconf about libmnl, libbpf, xtables and
other libraries. The importer reads these packages' .pc metadata while
loading the repository, but omits it from declared action outputs. A
configure action therefore cannot query the same packages as its CcInfo
dependencies without consulting the build host or recreating metadata.

Export the original .pc files through :pkgconfig on each imported package,
each architecture-selected package alias, and the dependency-set root.
Include only dependencies for the selected architecture (plus all).
Preserve the metadata bytes and leave path relocation to the declared
pkgconf invocation. Existing data and CcInfo targets are unchanged.

Upstream-Status: Pending
Signed-off-by: Guohan Lu <securely1g@gmail.com>
---
diff --git a/apt/private/deb_import.bzl b/apt/private/deb_import.bzl
--- a/apt/private/deb_import.bzl
+++ b/apt/private/deb_import.bzl
@@ -192,6 +192,7 @@
     hpp_files = []
     hpp_files_woext = []
     pc_files = []
+    pc_aliases = []
     o_files = []
     symlinks = {}
     so_regular_files = []
@@ -213,7 +214,7 @@
             symlink_target = line[is_symlink_idx + 4:]
             line = line[:is_symlink_idx]
             if line.endswith(".pc"):
-                continue
+                pc_aliases.append(line)
 
             # An absolute symlink
             if symlink_target.startswith("/"):
@@ -254,7 +255,7 @@
     #  - Else                        -> leave unresolved, and warn
     self_files = {
         f: None
-        for f in so_files + h_files + hpp_files + a_files + hpp_files_woext
+        for f in so_files + h_files + hpp_files + a_files + hpp_files_woext + pc_files
     }
     unresolved_symlinks = {}
     for (symlink, symlink_target) in symlinks.items():
@@ -299,7 +300,7 @@
 
     outs = []
 
-    for out in so_files + h_files + hpp_files + a_files + hpp_files_woext + o_files:
+    for out in so_files + h_files + hpp_files + a_files + hpp_files_woext + o_files + pc_files:
         if out not in symlinks:
             outs.append(out)
 
@@ -312,15 +313,21 @@
 
     pkgconfigs = []
     for pc in pc_files:
-        if rctx.path(_EXTRACT_DIR + "/" + pc).exists:
+        if pc not in pc_aliases and rctx.path(_EXTRACT_DIR + "/" + pc).exists:
             pkgconfigs.append(pc)
 
     build_file_content = """
+filegroup(
+    name = "pkgconfig",
+    srcs = {},
+    visibility = ["//visibility:public"],
+)
+
 so_library(
     name = "_so_libs",
     dynamic_libs = {}
 )
-""".format(so_files)
+""".format(pc_files, so_files)
 
     rpaths = {}
     for so in so_files + a_files:
diff --git a/apt/private/package.BUILD.tmpl b/apt/private/package.BUILD.tmpl
--- a/apt/private/package.BUILD.tmpl
+++ b/apt/private/package.BUILD.tmpl
@@ -17,3 +17,10 @@
     srcs = {deps} + [":data"],
     visibility = ["//visibility:public"],
 )
+
+# Original pkg-config metadata from this package and its selected dependencies.
+filegroup(
+    name = "pkgconfig",
+    srcs = {pkgconfig_deps} + ["@{repo_name}//:pkgconfig"],
+    visibility = ["//visibility:public"],
+)
diff --git a/apt/private/translate_dependency_set.bzl b/apt/private/translate_dependency_set.bzl
--- a/apt/private/translate_dependency_set.bzl
+++ b/apt/private/translate_dependency_set.bzl
@@ -72,6 +72,16 @@
 )
 
 
+# Original pkg-config files for the target architecture's package closure.
+filegroup(
+    name = "pkgconfig",
+    srcs = select({{
+        "//:linux_%s" % arch: ["//%s/%s:pkgconfig" % (package, arch) for package in packages]
+        for arch, packages in _PACKAGES.items()
+    }}) if _PACKAGES else {{}},
+    visibility = ["//visibility:public"],
+)
+
 # A filegroup that contains all the packages and the dpkg status file.
 filegroup(
     name = "{target_name}",
@@ -113,6 +123,12 @@
 alias(
     name = "control",
     actual = select({control_targets}, no_match_error = NO_MATCH_ERROR),
+    visibility = ["//visibility:public"],
+)
+
+alias(
+    name = "pkgconfig",
+    actual = select({pkgconfig_targets}, no_match_error = NO_MATCH_ERROR),
     visibility = ["//visibility:public"],
 )
 
@@ -141,9 +157,9 @@
 # this scoping, a package's `depends_on` (which spans every architecture the
 # lockfile knows about) would leak foreign-architecture deps into a single
 # architecture's target, causing file duplication that confuses `flatten`.
-def package_deps_for_architecture(packages, package, architecture):
+def package_deps_for_architecture(packages, package, architecture, target = "data"):
     return [
-        "@" + util.sanitize(dep_key) + "//:data"
+        "@" + util.sanitize(dep_key) + "//:" + target
         for dep_key in package["depends_on"]
         if packages[dep_key]["architecture"] in [architecture, "all"]
     ]
@@ -209,6 +225,7 @@
                     control_targets = '"@%s//:control"' % repo_name,
                     src = '"@%s//:data"' % repo_name,
                     deps = package_deps_for_architecture(packages, package, architecture),
+                    pkgconfig_deps = package_deps_for_architecture(packages, package, architecture, "pkgconfig"),
                     urls = [
                         uri + "/" + package["filename"]
                         for uri in sources[package["suite"]]["uris"]
@@ -244,6 +261,10 @@
                     "//:linux_%s" % architecture: "//%s/%s:data" % (package_name, architecture)
                     for architecture in architectures
                 }),
+                pkgconfig_targets = starlark_codegen_utils.to_dict_attr({
+                    "//:linux_%s" % architecture: "//%s/%s:pkgconfig" % (package_name, architecture)
+                    for architecture in architectures
+                }),
                 control_targets = starlark_codegen_utils.to_dict_attr({
                     "//:linux_%s" % architecture: "//%s/%s:control" % (package_name, architecture)
                     for architecture in architectures
