diff --git a/apt/tests/locked_import_test.bzl b/apt/tests/locked_import_test.bzl
new file mode 100644
index 0000000..70bf9ea
--- /dev/null
+++ b/apt/tests/locked_import_test.bzl
@@ -0,0 +1,97 @@
+"""Test locked runtime imports before network access or repository declarations."""
+
+load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+load("//apt/private:locked_import.bzl", "expanded_sets", "reachable_packages", "validation_error")
+
+_ROOT = "/trixie/app:amd64=1.0"
+_DEP = "/trixie/lib:amd64=2.0"
+_ALL = "/trixie/data:all=3.0"
+
+def _package(name, version, arch = "amd64", dependencies = []):
+    return {
+        "name": name,
+        "version": version,
+        "architecture": arch,
+        "suite": "trixie",
+        "sha256": "a" * 64,
+        "filename": "pool/" + name + ".deb",
+        "depends_on": dependencies,
+    }
+
+def _fixture():
+    return {
+        "version": 2,
+        "sources": {"trixie": {"uris": ["https://example.invalid/archive"]}},
+        "dependency_sets": {"image": {"sets": {"amd64": {"/trixie/app:amd64": "1.0"}}}},
+        "packages": {
+            _ROOT: _package("app", "1.0", dependencies = [_DEP]),
+            _DEP: _package("lib", "2.0", dependencies = [_ALL, _ROOT]),
+            _ALL: _package("data", "3.0", arch = "all"),
+        },
+    }
+
+def _closure_test(ctx):
+    env = unittest.begin(ctx)
+    document = _fixture()
+
+    # Includes an indirect architecture-independent dependency and a cycle.
+    asserts.equals(env, "", validation_error(document))
+    asserts.equals(env, {
+        "image": {"sets": {"amd64": {
+            "/trixie/app:amd64": "1.0",
+            "/trixie/lib:amd64": "2.0",
+            "/trixie/data:all": "3.0",
+        }}},
+    }, expanded_sets(document))
+    asserts.equals(env, sorted([_ROOT, _DEP, _ALL]), reachable_packages(document["packages"], [_ROOT]))
+    asserts.equals(env, [_DEP], document["packages"][_ROOT]["depends_on"])
+    return unittest.end(env)
+
+closure_test = unittest.make(_closure_test)
+
+def _invalid_lock_test(ctx):
+    env = unittest.begin(ctx)
+    document = _fixture()
+    document["version"] = 1
+    asserts.true(env, "version-2" in validation_error(document))
+    document = _fixture()
+    document["packages"].pop(_DEP)
+    asserts.true(env, "missing" in validation_error(document))
+    document = _fixture()
+    document["packages"][_DEP]["version"] = "9.0"
+    asserts.true(env, "identity" in validation_error(document))
+    document = _fixture()
+    document["packages"][_DEP]["architecture"] = "arm64"
+    asserts.true(env, "foreign architecture" in validation_error(document))
+    document = _fixture()
+    document["packages"][_DEP]["sha256"] = "not-a-checksum"
+    asserts.true(env, "SHA256" in validation_error(document))
+    document = _fixture()
+    document["packages"][_DEP]["filename"] = "../outside.deb"
+    asserts.true(env, "unsafe" in validation_error(document))
+    document = _fixture()
+    document["sources"] = {}
+    asserts.true(env, "source URLs" in validation_error(document))
+    return unittest.end(env)
+
+invalid_lock_test = unittest.make(_invalid_lock_test)
+
+def _selection_test(ctx):
+    env = unittest.begin(ctx)
+    document = _fixture()
+    document["dependency_sets"]["other"] = {"sets": {"arm64": {"/trixie/data:all": "3.0"}}}
+    asserts.equals(env, ["other"], expanded_sets(document, ["other"]).keys())
+    asserts.equals(env, {"/trixie/data:all": "3.0"}, expanded_sets(document, ["other"])["other"]["sets"]["arm64"])
+    asserts.true(env, "lacks dependency set" in validation_error(document, ["absent"]))
+    asserts.true(env, "distinct" in validation_error(document, ["image", "image"]))
+    document["packages"]["/trixie/lib:amd64=4.0"] = _package("lib", "4.0")
+    document["packages"][_ROOT]["depends_on"].append("/trixie/lib:amd64=4.0")
+    asserts.true(env, "two versions" in validation_error(document))
+    return unittest.end(env)
+
+selection_test = unittest.make(_selection_test)
+
+def locked_import_tests():
+    closure_test(name = "locked_import/closure")
+    invalid_lock_test(name = "locked_import/invalid_lock")
+    selection_test(name = "locked_import/selection")
