diff --git a/apt/private/locked_import.bzl b/apt/private/locked_import.bzl
new file mode 100644
index 0000000..a917d81
--- /dev/null
+++ b/apt/private/locked_import.bzl
@@ -0,0 +1,153 @@
+"""Import reviewed runtime package graphs through the existing APT repositories."""
+
+load(":deb_import.bzl", "deb_import")
+load(":translate_dependency_set.bzl", "translate_dependency_set")
+load(":util.bzl", "util")
+
+def validation_error(document, requested = []):
+    """Return a useful error before any repository is declared or downloaded."""
+    if type(document) != "dict" or document.get("version") != 2:
+        return "apt.import_lock requires a version-2 lock"
+    for field in ["sources", "packages", "dependency_sets"]:
+        if type(document.get(field)) != "dict":
+            return "APT lock lacks " + field
+    groups = requested or document["dependency_sets"].keys()
+    if not groups or len(groups) != len({name: True for name in groups}):
+        return "APT lock needs distinct dependency sets"
+    for group in groups:
+        if not group or any([character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.+-" for character in group.elems()]):
+            return "invalid APT dependency set: " + group
+        if group not in document["dependency_sets"]:
+            return "APT lock lacks dependency set: " + group
+        definition = document["dependency_sets"][group]
+        if type(definition) != "dict" or type(definition.get("sets")) != "dict" or not definition["sets"]:
+            return "APT dependency set lacks architectures: " + group
+        for architecture, roots in definition["sets"].items():
+            if architecture == "all" or not architecture or type(roots) != "dict" or not roots:
+                return "invalid APT architecture or roots: " + group
+            if any([type(key) != "string" or type(version) != "string" or not version for key, version in roots.items()]):
+                return "invalid locked APT root identity: " + group
+            pending = [key + "=" + version for key, version in roots.items()]
+            seen = {}
+            names = {}
+            for _ in range(len(document["packages"]) + 1):
+                if not pending:
+                    break
+                following = []
+                for key in pending:
+                    if key in seen:
+                        continue
+                    if key not in document["packages"]:
+                        return "APT dependency is missing from the lock: " + key
+                    package = document["packages"][key]
+                    if type(package) != "dict":
+                        return "invalid locked APT package: " + key
+                    for field in ["name", "version", "architecture", "sha256", "filename", "suite"]:
+                        if type(package.get(field)) != "string" or not package[field]:
+                            return "locked APT package lacks " + field + ": " + key
+                    if type(package.get("depends_on")) != "list" or any([type(dependency) != "string" for dependency in package["depends_on"]]):
+                        return "locked APT package lacks dependency graph: " + key
+                    if any([character not in "abcdefghijklmnopqrstuvwxyz0123456789+.-" for character in package["name"].elems()]) or package["name"] in [".", ".."]:
+                        return "invalid locked APT package name: " + key
+                    if key not in ["/" + package["suite"] + "/" + package["name"] + ":" + arch + "=" + package["version"] for arch in [architecture, "all"]]:
+                        return "APT package key has the wrong identity or architecture: " + key
+                    if package["architecture"] not in [architecture, "all"] or (":all=" in key and package["architecture"] != "all"):
+                        return "APT package has a foreign architecture: " + key
+                    digest = package["sha256"]
+                    if len(digest) != 64 or any([character not in "0123456789abcdef" for character in digest.elems()]):
+                        return "APT package lacks a SHA256 digest: " + key
+                    filename = package["filename"]
+                    if filename.startswith("/") or ".." in filename.split("/"):
+                        return "unsafe APT package filename: " + key
+                    source = document["sources"].get(package["suite"], {})
+                    if type(source) != "dict" or type(source.get("uris")) != "list" or not source["uris"] or any([type(uri) != "string" or not uri for uri in source["uris"]]):
+                        return "APT package lacks source URLs: " + key
+                    if package["name"] in names and names[package["name"]] != key:
+                        return "APT dependency set contains two versions of " + package["name"]
+                    names[package["name"]] = key
+                    seen[key] = True
+                    following.extend(package["depends_on"])
+                pending = following
+    return ""
+
+def reachable_packages(packages, roots):
+    """Find the complete closure of a validated graph, including cyclic edges."""
+    pending = roots
+    seen = {}
+    for _ in range(len(packages) + 1):
+        if not pending:
+            break
+        following = []
+        for key in pending:
+            if key not in seen:
+                seen[key] = True
+                following.extend(packages[key]["depends_on"])
+        pending = following
+    return sorted(seen)
+
+def expanded_sets(document, requested = []):
+    """Expose every locked dependency independently, preserving target architectures."""
+    error = validation_error(document, requested)
+    if error:
+        fail(error)
+    result = {}
+    for group in requested or document["dependency_sets"].keys():
+        architectures = {}
+        for architecture, roots in document["dependency_sets"][group]["sets"].items():
+            pending = [key + "=" + version for key, version in roots.items()]
+            seen = reachable_packages(document["packages"], pending)
+            architectures[architecture] = {key.rsplit("=", 1)[0]: document["packages"][key]["version"] for key in sorted(seen)}
+        result[group] = {"sets": architectures}
+    return result
+
+def declare_locked_imports(mctx, existing_sets):
+    """Reuse deb_import/deb_postfix and the hub generator without index resolution.
+
+    Runtime imports intentionally do not publish C++ compilation targets: a
+    version-2 lock contains archive identities, not Debian Contents-index maps.
+    Ordinary apt.install keeps its existing compiler/header exports.
+    """
+    declared = {name: True for name in existing_sets}
+    for module in mctx.modules:
+        for tag in module.tags.import_lock:
+            document = json.decode(mctx.read(tag.lock))
+            for group, definition in expanded_sets(document, tag.dependency_sets).items():
+                if group in declared:
+                    fail("APT dependency set is already declared: " + group)
+                declared[group] = True
+                prefix = "locked_import_" + group + "_"
+                selected = {key + "=" + version: True for roots in definition["sets"].values() for key, version in roots.items()}
+                imported_packages = {
+                    key: dict(document["packages"][key], depends_on = [
+                        dependency
+                        for dependency in reachable_packages(document["packages"], [key])
+                        if dependency != key
+                    ])
+                    for key in selected
+                }
+                package_repositories = {}
+                for key in selected:
+                    name = prefix + util.sanitize(key)
+                    if name in package_repositories:
+                        fail("locked APT package repository names collide: " + key)
+                    package_repositories[name] = True
+                    package = imported_packages[key]
+                    deb_import(
+                        name = name,
+                        target_name = name,
+                        urls = [uri.rstrip("/") + "/" + package["filename"] for uri in document["sources"][package["suite"]]["uris"]],
+                        sha256 = package["sha256"],
+                        package_name = package["name"],
+                        depends_on = package["depends_on"],
+                        repo_prefix = prefix,
+                        payload_only = True,
+                        mergedusr = False,
+                    )
+                locked = dict(document, packages = imported_packages, dependency_sets = {group: definition})
+                translate_dependency_set(
+                    name = group,
+                    depset_name = group,
+                    lock_content = json.encode(locked),
+                    repo_prefix = prefix,
+                    payload_only = True,
+                )
