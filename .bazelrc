# Local builds pin the registry snapshot containing the reviewed tar.bzl patch.
# CI ignores this file and uses its matching temporary registry branch.
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/bc7d6f89f0045327aaddcc8cfe9ae9a23e60f8e0
# If a dependency is not found there, use the Bazel Central Registry
common --registry=https://bcr.bazel.build/

# Build all release binaries for `trixie`.
# These are host toolchains (exec == target == $cpu),
# so --config=aarch64 only resolves when Bazel itself is running on an aarch64 machine.
common --platforms=//platforms:x86_64_trixie
common:aarch64 --platforms=//platforms:aarch64_trixie

test --test_output=errors
