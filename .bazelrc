# Local builds pin the landed registry snapshot containing the tar.bzl patch.
# CI ignores this file and uses the maintained registry main branch.
common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/3fc93604f17c358630171af3094f375b6c88ed3b
# If a dependency is not found there, use the Bazel Central Registry
common --registry=https://bcr.bazel.build/

# Build all release binaries for `trixie`.
# These are host toolchains (exec == target == $cpu),
# so --config=aarch64 only resolves when Bazel itself is running on an aarch64 machine.
common --platforms=//platforms:x86_64_trixie
common:aarch64 --platforms=//platforms:aarch64_trixie

test --test_output=errors
