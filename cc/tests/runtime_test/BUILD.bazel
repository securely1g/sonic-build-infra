load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//cc:runtime_test.bzl", "native_runtime_binary", "native_runtime_test")

cc_binary(name = "program", srcs = ["program.c"])

native_runtime_binary(
    name = "wrapped",
    binary = ":program",
    runtime_payloads = ["@build_tools//libc6:data"],
)

native_runtime_test(
    name = "native_test",
    binary = ":program",
    runtime_payloads = ["@build_tools//libc6:data"],
    args = ["native-test", "0"],
)

py_test(
    name = "contract_test",
    srcs = ["contract_test.py"],
    args = ["$(location :wrapped)", "$(location :missing_runtime)", "$(location :exec_tool_output)", "$(location :instrumented)", "$(location :memchecked)"],
    data = [":wrapped", ":missing_runtime", ":exec_tool_output", ":instrumented", ":memchecked"],
)

native_runtime_binary(name = "missing_runtime", binary = ":program", runtime_payloads = [])

genrule(
    name = "exec_tool_output",
    tools = [":wrapped"],
    outs = ["exec-tool.txt"],
    cmd = "$(location :wrapped) 'exec tool' 0 > $@",
)

native_runtime_binary(
    name = "instrumented",
    binary = ":program",
    runtime_payloads = ["@build_tools//libc6:data", "@build_tools//libc6-dbg:data"],
    instrument = "//tools/build_tools:valgrind",
    instrument_args = ["--quiet", "--error-exitcode=86", "--leak-check=full"],
)

cc_binary(name = "memory_access", srcs = ["memory_access.c"])

native_runtime_binary(
    name = "memchecked",
    binary = ":memory_access",
    runtime_payloads = ["@build_tools//libc6:data", "@build_tools//libc6-dbg:data"],
    instrument = "//tools/build_tools:valgrind",
    instrument_args = ["--quiet", "--error-exitcode=86", "--leak-check=full"],
)

# Distinct SONAMEs and a relocatable three-object graph exercise the ELF loader
# contract independently of Bazel's generated solib search paths.
cc_binary(
    name = "liborigin_leaf.so",
    srcs = ["origin_leaf.c"],
    linkshared = True,
    linkopts = ["-Wl,-soname,liborigin_leaf.so"],
)

cc_binary(
    name = "liborigin_middle.so",
    srcs = ["origin_middle.c", ":liborigin_leaf.so"],
    linkshared = True,
    linkopts = ["-Wl,-soname,liborigin_middle.so"],
)

cc_binary(
    name = "origin_program",
    srcs = ["origin_main.c", ":liborigin_middle.so"],
    linkopts = ["-Wl,--allow-shlib-undefined"],
)

py_test(
    name = "origin_contract_test",
    srcs = ["origin_contract_test.py", "//cc:runtime_test.py"],
    main = "origin_contract_test.py",
    args = [
        "$(location :origin_program)",
        "$(location :liborigin_middle.so)",
        "$(location :liborigin_leaf.so)",
        "$(location @patchelf//:patchelf)",
        "$(location @build_tools//libc6:data)",
    ],
    data = [":origin_program", ":liborigin_middle.so", ":liborigin_leaf.so", "@patchelf//:patchelf", "@build_tools//libc6:data"],
    deps = ["//deb:elf_metadata"],
)
