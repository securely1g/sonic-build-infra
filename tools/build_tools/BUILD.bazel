py_test(
    name = "perl_bookworm_test",
    srcs = ["perl_bookworm_test.py"],
    args = ["$(location :perl_bookworm_runtime)", "$(location :perl_bookworm)"],
    data = [":perl_bookworm_runtime", ":perl_bookworm"],
)

# The tool runs on the execution CPU while its package suite is explicitly chosen.
[
    build_tools_runtime(name = "bookworm_test_runtime_" + architecture, architecture = architecture, profile = "tests", packages = ["@bookworm_build_tools//" + package for package in ["valgrind", "libc6-dbg", "tcl8.6", "tcl-expect"]], exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:" + cpu])
    for architecture, cpu in [("amd64", "x86_64"), ("arm64", "aarch64")]
]
alias(name = "bookworm_test_runtime", actual = select({"@platforms//cpu:x86_64": ":bookworm_test_runtime_amd64", "@platforms//cpu:aarch64": ":bookworm_test_runtime_arm64"}), visibility = ["//visibility:public"])
build_tool(name = "valgrind_bookworm", tool = "valgrind", runtime = ":bookworm_test_runtime", visibility = ["//visibility:public"])
py_test(
    name = "bookworm_test_runtime_test",
    srcs = ["bookworm_test_runtime_test.py", "test_runtime_test.py"],
