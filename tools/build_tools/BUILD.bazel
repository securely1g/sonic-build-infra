load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")
load("@rules_python//python:defs.bzl", "py_test")
load(":defs.bzl", "build_tool", "build_tools_runtime", "check_build_tools", "python_runtime")

python_runtime(name = "python_runtime")

[
    build_tools_runtime(
        name = "runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = [
            "@build_tools//aspell",
            "@build_tools//aspell-en",
            "@build_tools//doxygen",
        ],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":runtime_amd64",
        "@platforms//cpu:aarch64": ":runtime_arm64",
    }),
)

[
    build_tool(
        name = tool,
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "aspell",
        "doxygen",
    ]
]

py_test(
    name = "runtime_test",
    srcs = ["runtime_test.py"],
    args = [
        "$(location :aspell)",
        "$(location :doxygen)",
    ],
    data = [
        ":aspell",
        ":doxygen",
    ],
    python_version = "PY3",
    visibility = ["//visibility:public"],
)

check_build_tools(
    name = "launcher_action_check",
    aspell = ":aspell",
    doxygen = ":doxygen",
    visibility = ["//visibility:public"],
)

# A separate bundle avoids pulling documentation tools into configure builds.
[
    build_tools_runtime(
        name = "configure_runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = ["@build_make_" + architecture + "//:data.tar.xz"] + [
            "@build_tools//" + tool
            for tool in [
                "m4",
                "pkgconf",
                "perl",
                "bison",
                "flex",
                "autoconf",
                "grep",
            ]
        ],
        profile = "configure",
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "configure_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":configure_runtime_amd64",
        "@platforms//cpu:aarch64": ":configure_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(
        name = tool,
        runtime = ":configure_runtime",
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "make",
        "m4",
        "pkgconf",
        "perl",
        "bison",
        "flex",
        "autoconf",
        "autoheader",
        "autom4te",
    ]
]

# foreign_cc expands each tool target separately. Distinct labels let all
# three tools share one runtime tree without duplicate-label expansion.
[
    filegroup(
        name = tool + "_runtime",
        srcs = [":configure_runtime"],
    )
    for tool in [
        "make",
        "m4",
        "pkgconfig",
        "autoconf",
    ]
]

[
    native_tool_toolchain(
        name = toolchain_type + "_tool",
        env = {variable: "$(execpath :" + toolchain_type + "_runtime)/bin/" + tool},
        path = "$(execpath :" + toolchain_type + "_runtime)/bin/" + tool,
        target = ":" + toolchain_type + "_runtime",
    )
    for toolchain_type, tool, variable in [
        ("make", "make", "MAKE"),
        ("m4", "m4", "M4"),
        ("pkgconfig", "pkgconf", "PKG_CONFIG"),
        ("autoconf", "autoconf", "AUTOCONF"),
    ]
]

[
    toolchain(
        name = toolchain_type + "_toolchain",
        exec_compatible_with = ["@platforms//os:linux"],
        toolchain = ":" + toolchain_type + "_tool",
        toolchain_type = "@rules_foreign_cc//toolchains:" + toolchain_type + "_toolchain",
        visibility = ["//visibility:public"],
    )
    for toolchain_type in [
        "make",
        "m4",
        "pkgconfig",
        "autoconf",
    ]
]

py_test(
    name = "configure_runtime_test",
    srcs = ["configure_runtime_test.py"],
    args = ["$(location :" + tool + ")" for tool in [
        "make",
        "m4",
        "pkgconf",
        "perl",
        "bison",
        "flex",
        "autoconf",
        "autoheader",
        "autom4te",
    ]],
    data = [
        ":autoconf",
        ":autoheader",
        ":autom4te",
        ":bison",
        ":flex",
        ":m4",
        ":make",
        ":perl",
        ":pkgconf",
    ],
    visibility = ["//visibility:public"],
)

# Compile one small upstream-style project through the registered toolchains.
filegroup(
    name = "configure_probe_sources",
    srcs = [
        "tests/configure",
        "tests/probe.c",
    ],
)

configure_make(
    name = "configure_probe",
    build_data = [":configure_runtime"],
    configure_in_place = True,
    env = {"PERL": "$(execpath :configure_runtime)/bin/perl"},
    features = ["-sanitize_pwd"],
    lib_source = ":configure_probe_sources",
    out_static_libs = ["libprobe.a"],
)

cc_binary(
    name = "configure_probe_binary",
    srcs = ["tests/main.c"],
    deps = [":configure_probe"],
)

py_test(
    name = "configure_make_test",
    srcs = ["configure_make_test.py"],
    args = ["$(location :configure_probe_binary)"],
    data = [":configure_probe_binary"],
    visibility = ["//visibility:public"],
)

# These tools generate package metadata; they do not build Debian archives.
[
    build_tools_runtime(
        name = "metadata_runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = [
            "@build_tools//base-files",
            "@build_tools//binutils",
            "@build_tools//dpkg-dev",
            "@build_tools//perl",
        ],
        profile = "metadata",
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "metadata_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":metadata_runtime_amd64",
        "@platforms//cpu:aarch64": ":metadata_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(
        name = tool,
        runtime = ":metadata_runtime",
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "dpkg-gencontrol",
        "dpkg-shlibdeps",
        "dpkg-gensymbols",
    ]
]

py_test(
    name = "metadata_runtime_test",
    srcs = ["metadata_runtime_test.py"],
    args = [
        "--gencontrol=$(location :dpkg-gencontrol)",
        "--shlibdeps=$(location :dpkg-shlibdeps)",
        "--gensymbols=$(location :dpkg-gensymbols)",
        "--library=$(location :libmetadata_probe.so)",
        "--runtime=$(location :metadata_runtime)",
        "--binary=$(location :metadata_probe_binary)",
        "--libc-data=$(location @build_tools//libc6:data)",
        "--libc-control=$(location @build_tools//libc6:control)",
    ],
    data = [
        ":dpkg-gencontrol",
        ":dpkg-gensymbols",
        ":dpkg-shlibdeps",
        ":libmetadata_probe.so",
        ":metadata_probe_binary",
        ":metadata_runtime",
        "@build_tools//libc6:control",
        "@build_tools//libc6:data",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "metadata_probe_binary",
    srcs = ["tests/metadata_probe.c"],
)

cc_binary(
    name = "libmetadata_probe.so",
    srcs = ["tests/metadata_probe_library.c"],
    linkopts = ["-Wl,-soname,libmetadata-probe.so.1"],
    linkshared = True,
)

# Debian's own maintainer-script and metadata generators, with pinned tools.
[
    build_tools_runtime(
        name = "debian_runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = [
            "@build_tools//base-files",
            "@build_tools//binutils",
            "@build_tools//coreutils",
            "@build_tools//dash",
            "@build_tools//debhelper",
            "@build_tools//dh-python",
            "@build_tools//findutils",
            "@build_tools//grep",
            "@build_tools//mawk",
            "@build_tools//po-debconf",
            "@build_tools//python3",
            "@build_tools//sed",
        ],
        profile = "debian",
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "debian_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":debian_runtime_amd64",
        "@platforms//cpu:aarch64": ":debian_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(
        name = tool,
        runtime = ":debian_runtime",
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "dh_install",
        "dh_fixperms",
        "dh_installinit",
        "dh_installdeb",
        "dh_installdebconf",
        "dh_makeshlibs",
        "dh_perl",
        "dh_installsystemduser",
        "dh_python3",
        "dh_installtmpfiles",
    ]
]

py_test(
    name = "debian_runtime_test",
    srcs = ["debian_runtime_test.py"],
    args = [
        "--install=$(location :dh_install)",
        "--fixperms=$(location :dh_fixperms)",
        "--installinit=$(location :dh_installinit)",
        "--installdeb=$(location :dh_installdeb)",
        "--installdebconf=$(location :dh_installdebconf)",
        "--makeshlibs=$(location :dh_makeshlibs)",
        "--perl=$(location :dh_perl)",
        "--systemduser=$(location :dh_installsystemduser)",
        "--python=$(location :dh_python3)",
        "--tmpfiles=$(location :dh_installtmpfiles)",
        "--library=$(location :libmetadata_probe.so)",
        "--runtime=$(location :debian_runtime)",
    ],
    data = [
        ":debian_runtime",
        ":dh_fixperms",
        ":dh_install",
        ":dh_installdeb",
        ":dh_installdebconf",
        ":dh_installinit",
        ":dh_installsystemduser",
        ":dh_installtmpfiles",
        ":dh_makeshlibs",
        ":dh_perl",
        ":dh_python3",
        ":libmetadata_probe.so",
    ],
    visibility = ["//visibility:public"],
)

# Kerberos keeps Debian's compile_et and mk_cmds rather than selecting its
# bundled substitutes. Give these generators their own small execution bundle.
[
    build_tools_runtime(
        name = "kerberos_runtime_" + architecture,
        architecture = architecture,
        profile = "kerberos",
        exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:" + cpu],
        packages = ["@build_tools//" + tool for tool in [
            "comerr-dev", "ss-dev", "mawk", "sed", "grep", "coreutils", "diffutils",
        ]],
    )
    for architecture, cpu in [("amd64", "x86_64"), ("arm64", "aarch64")]
]

alias(
    name = "kerberos_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":kerberos_runtime_amd64",
        "@platforms//cpu:aarch64": ":kerberos_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(
        name = tool,
        tool = tool,
        runtime = ":kerberos_runtime",
        visibility = ["//visibility:public"],
    )
    for tool in ["compile_et", "mk_cmds"]
]

py_test(
    name = "kerberos_runtime_test",
    srcs = ["kerberos_runtime_test.py"],
    args = ["$(location :kerberos_runtime)", "$(location :compile_et)", "$(location :mk_cmds)"],
    data = [":kerberos_runtime", ":compile_et", ":mk_cmds"],
    visibility = ["//visibility:public"],
)
