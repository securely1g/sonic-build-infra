alias(
    name = "runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":runtime_amd64",
        "@platforms//cpu:aarch64": ":runtime_arm64",
    }),
)

[
    build_tool(
        name = tool,
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "aspell",
        "doxygen",
    ]
]

py_test(
    name = "runtime_test",
    srcs = ["runtime_test.py"],
    args = [
        "$(location :aspell)",
        "$(location :doxygen)",
    ],
    data = [
        ":aspell",
        ":doxygen",
