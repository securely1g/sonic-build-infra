load("@rules_python//python:defs.bzl", "py_test")
load(":defs.bzl", "build_tool", "build_tools_rootfs", "build_tools_runtime", "check_build_tools", "python_runtime")

python_runtime(name = "python_runtime")

# dpkg-shlibdeps needs the native runtime libraries' symbols/shlibs metadata and
# file ownership lists when packaging the source-built linux-kbuild programs.
_KERNEL_LINK_LIBRARIES = [
    "libc6",
    "libelf1t64",
    "libgcc-s1",
    "libssl3t64",
    "libzstd1",
    "zlib1g",
]

[
    build_tools_rootfs(
        name = "kernel_runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        metadata_controls = ["@build_tools//" + name + ":control" for name in _KERNEL_LINK_LIBRARIES],
        metadata_data = ["@build_tools//" + name + ":data" for name in _KERNEL_LINK_LIBRARIES],
        packages = ["@build_tools"],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "kernel_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":kernel_runtime_amd64",
        "@platforms//cpu:aarch64": ":kernel_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

py_test(
    name = "prepare_rootfs_test",
    srcs = [
        "prepare_rootfs.py",
        "prepare_rootfs_test.py",
        "prepare_runtime.py",
    ],
    imports = ["."],
    main = "prepare_rootfs_test.py",
    python_version = "PY3",
)

py_test(
    name = "kernel_runtime_test",
    srcs = ["kernel_runtime_test.py"],
    args = ["$(location :kernel_runtime)"],
    data = [":kernel_runtime"],
    python_version = "PY3",
    tags = [
        "no-remote-exec",
        "no-sandbox",
        "requires-root",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"],
)

[
    build_tools_runtime(
        name = "runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = [
            "@build_tools//aspell",
            "@build_tools//aspell-en",
            "@build_tools//doxygen",
        ],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":runtime_amd64",
        "@platforms//cpu:aarch64": ":runtime_arm64",
    }),
)

[
    build_tool(
        name = tool,
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "aspell",
        "doxygen",
    ]
]

py_test(
    name = "runtime_test",
    srcs = ["runtime_test.py"],
    args = [
        "$(location :aspell)",
        "$(location :doxygen)",
    ],
    data = [
        ":aspell",
        ":doxygen",
    ],
    python_version = "PY3",
    visibility = ["//visibility:public"],
)

check_build_tools(
    name = "launcher_action_check",
    aspell = ":aspell",
    doxygen = ":doxygen",
    visibility = ["//visibility:public"],
)
