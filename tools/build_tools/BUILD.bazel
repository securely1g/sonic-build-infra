    build_tools_runtime(
        name = "perl_bookworm_runtime_" + architecture,
        architecture = architecture,
        profile = "perl",
        exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:" + cpu],
        packages = ["@bookworm_build_tools//" + package for package in ["perl", "perl-base", "perl-modules-5.36", "libperl-dev"]],
    )
    for architecture, cpu in [("amd64", "x86_64"), ("arm64", "aarch64")]
]
alias(
    name = "perl_bookworm_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":perl_bookworm_runtime_amd64",
        "@platforms//cpu:aarch64": ":perl_bookworm_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)
build_tool(
    name = "perl_bookworm",
    tool = "perl",
    runtime = ":perl_bookworm_runtime",
