[
    build_tools_runtime(
        name = "runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = [
            "@build_tools//aspell",
            "@build_tools//aspell-en",
            "@build_tools//doxygen",
        ],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
