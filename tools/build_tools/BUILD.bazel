load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")
load("@rules_python//python:defs.bzl", "py_test")
load(":defs.bzl", "build_tool", "build_tools_rootfs", "build_tools_runtime", "check_build_tools", "python_runtime")

python_runtime(name = "python_runtime")

cc_binary(
    name = "runtime_launcher",
    srcs = ["runtime_launcher.c"],
    linkopts = ["-static"],
    linkstatic = True,
)

py_test(
    name = "runtime_launcher_test",
    srcs = [
        "prepare_runtime.py",
        "runtime_launcher_test.py",
    ],
    args = ["$(location :runtime_launcher)"],
    data = [":runtime_launcher"],
    imports = ["."],
    main = "runtime_launcher_test.py",
    visibility = ["//visibility:public"],
)

# dpkg-shlibdeps needs the native runtime libraries' symbols/shlibs metadata and
# file ownership lists when packaging the source-built linux-kbuild programs.
# Keep the kernel root independent of unrelated source-generator packages.
_KERNEL_LINK_LIBRARIES = [
    "libc6",
    "libelf1t64",
    "libgcc-s1",
    "libssl3t64",
    "libzstd1",
    "zlib1g",
]

[
    build_tools_rootfs(
        name = "kernel_runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        metadata_controls = ["@kernel_build_tools//" + name + ":control" for name in _KERNEL_LINK_LIBRARIES],
        metadata_data = ["@kernel_build_tools//" + name + ":data" for name in _KERNEL_LINK_LIBRARIES],
        packages = ["@kernel_build_tools"],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "kernel_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":kernel_runtime_amd64",
        "@platforms//cpu:aarch64": ":kernel_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

py_test(
    name = "prepare_rootfs_test",
    srcs = [
        "prepare_rootfs.py",
        "prepare_rootfs_test.py",
        "prepare_runtime.py",
    ],
    imports = ["."],
    main = "prepare_rootfs_test.py",
    python_version = "PY3",
)

py_test(
    name = "kernel_runtime_test",
    srcs = ["kernel_runtime_test.py"],
    args = ["$(location :kernel_runtime)"],
    data = [":kernel_runtime"],
    python_version = "PY3",
    tags = [
        "no-remote-exec",
        "no-sandbox",
        "requires-root",
    ],
)

[
    build_tools_runtime(
        name = "runtime_" + architecture,
        architecture = architecture,
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        packages = [
            "@build_tools//aspell",
            "@build_tools//aspell-en",
            "@build_tools//doxygen",
        ],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":runtime_amd64",
        "@platforms//cpu:aarch64": ":runtime_arm64",
    }),
)

[
    build_tool(
        name = tool,
        tool = tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "aspell",
        "doxygen",
    ]
]

py_test(
    name = "runtime_test",
    srcs = ["runtime_test.py"],
    args = [
        "$(location :aspell)",
        "$(location :doxygen)",
    ],
    data = [
        ":aspell",
        ":doxygen",
    ],
    python_version = "PY3",
    visibility = ["//visibility:public"],
)

check_build_tools(
    name = "launcher_action_check",
    aspell = ":aspell",
    doxygen = ":doxygen",
    visibility = ["//visibility:public"],
)

# A separate bundle avoids pulling documentation tools into configure builds.
[
    build_tools_runtime(
        name = "configure_runtime_" + architecture,
        architecture = architecture,
        profile = "configure",
        exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:" + cpu],
        packages = ["@build_make_" + architecture + "//:data.tar.xz"] + [
            "@build_tools//" + tool for tool in ["m4", "pkgconf", "perl", "bison", "flex", "autoconf", "grep"]
        ],
    )
    for architecture, cpu in [("amd64", "x86_64"), ("arm64", "aarch64")]
]

alias(
    name = "configure_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":configure_runtime_amd64",
        "@platforms//cpu:aarch64": ":configure_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(
        name = tool,
        tool = tool,
        runtime = ":configure_runtime",
        visibility = ["//visibility:public"],
    )
    for tool in ["make", "m4", "pkgconf", "perl", "bison", "flex", "autoconf", "autoheader", "autom4te"]
]

# foreign_cc expands each tool target separately. Distinct labels let all
# three tools share one runtime tree without duplicate-label expansion.
[
    filegroup(
        name = tool + "_runtime",
        srcs = [":configure_runtime"],
    )
    for tool in ["make", "m4", "pkgconfig", "autoconf"]
]

[
    native_tool_toolchain(
        name = toolchain_type + "_tool",
        target = ":" + toolchain_type + "_runtime",
        path = "$(execpath :" + toolchain_type + "_runtime)/bin/" + tool,
        env = {variable: "$(execpath :" + toolchain_type + "_runtime)/bin/" + tool},
    )
    for toolchain_type, tool, variable in [
        ("make", "make", "MAKE"),
        ("m4", "m4", "M4"),
        ("pkgconfig", "pkgconf", "PKG_CONFIG"),
        ("autoconf", "autoconf", "AUTOCONF"),
    ]
]

[
    toolchain(
        name = toolchain_type + "_toolchain",
        toolchain = ":" + toolchain_type + "_tool",
        toolchain_type = "@rules_foreign_cc//toolchains:" + toolchain_type + "_toolchain",
        exec_compatible_with = ["@platforms//os:linux"],
        visibility = ["//visibility:public"],
    )
    for toolchain_type in ["make", "m4", "pkgconfig", "autoconf"]
]

py_test(
    name = "configure_runtime_test",
    srcs = ["configure_runtime_test.py"],
    args = ["$(location :" + tool + ")" for tool in [
        "make",
        "m4",
        "pkgconf",
        "perl",
        "bison",
        "flex",
        "autoconf",
        "autoheader",
        "autom4te",
    ]] + [
        "--runtime",
        "$(location :configure_runtime)",
    ],
    data = [
        ":autoconf",
        ":autoheader",
        ":autom4te",
        ":bison",
        ":configure_runtime",
        ":flex",
        ":m4",
        ":make",
        ":perl",
        ":pkgconf",
    ],
    visibility = ["//visibility:public"],
)

# Compile one small upstream-style project through the registered toolchains.
filegroup(
    name = "configure_probe_sources",
    srcs = ["tests/configure", "tests/probe.c"],
)

configure_make(
    name = "configure_probe",
    lib_source = ":configure_probe_sources",
    build_data = [":configure_runtime"],
    configure_in_place = True,
    env = {"PERL": "$(execpath :configure_runtime)/bin/perl"},
    features = ["-sanitize_pwd"],
    out_static_libs = ["libprobe.a"],
)

cc_binary(
    name = "configure_probe_binary",
    srcs = ["tests/main.c"],
    deps = [":configure_probe"],
)

py_test(
    name = "configure_make_test",
    srcs = ["configure_make_test.py"],
    args = ["$(location :configure_probe_binary)"],
    data = [":configure_probe_binary"],
    visibility = ["//visibility:public"],
)

# Kerberos keeps Debian's compile_et and mk_cmds rather than selecting its
# bundled substitutes. Give these generators their own small execution bundle.
[
    build_tools_runtime(
        name = "kerberos_runtime_" + architecture,
        architecture = architecture,
        profile = "kerberos",
        exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:" + cpu],
        packages = ["@build_tools//" + tool for tool in [
            "comerr-dev", "ss-dev", "mawk", "sed", "grep", "coreutils", "diffutils",
        ]],
    )
    for architecture, cpu in [("amd64", "x86_64"), ("arm64", "aarch64")]
]

alias(
    name = "kerberos_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":kerberos_runtime_amd64",
        "@platforms//cpu:aarch64": ":kerberos_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(
        name = tool,
        tool = tool,
        runtime = ":kerberos_runtime",
        visibility = ["//visibility:public"],
    )
    for tool in ["compile_et", "mk_cmds"]
]

py_test(
    name = "kerberos_runtime_test",
    srcs = ["kerberos_runtime_test.py"],
    args = ["$(location :kerberos_runtime)", "$(location :compile_et)", "$(location :mk_cmds)"],
    data = [":kerberos_runtime", ":compile_et", ":mk_cmds"],
    visibility = ["//visibility:public"],
)

# Autotools bootstrap and interface generators run on the execution platform.
# Their libraries/data are private; target headers/libraries remain consumer deps.
[
    build_tools_runtime(
        name = "foreign_runtime_" + architecture,
        architecture = architecture,
        profile = "foreign",
        exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:" + cpu],
        packages = ["@build_make_" + architecture + "//:data.tar.xz"] + [
            "@build_tools//" + tool for tool in [
                "m4", "pkgconf", "perl", "bison", "flex", "autoconf", "automake",
                "libtool", "libtool-bin", "coreutils", "diffutils", "grep", "sed", "mawk",
                "findutils", "bash", "dash", "protobuf-compiler", "protobuf-compiler-grpc",
                "thrift-compiler", "python3", "libxml-simple-perl", "graphviz", "fonts-dejavu-core", "debianutils",
            ]
        ] + ["@build_tools//libprotobuf-dev:data"],
    )
    for architecture, cpu in [("amd64", "x86_64"), ("arm64", "aarch64")]
]

alias(
    name = "foreign_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":foreign_runtime_amd64",
        "@platforms//cpu:aarch64": ":foreign_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

[
    build_tool(name = tool, tool = tool, runtime = ":foreign_runtime", visibility = ["//visibility:public"])
    for tool in ["autoreconf", "automake", "aclocal", "libtoolize", "protoc", "grpc_cpp_plugin", "grpc_python_plugin", "thrift", "python3", "dot"]
]

py_test(
    name = "foreign_runtime_test",
    srcs = ["foreign_runtime_test.py"],
    args = ["$(location :foreign_runtime)", "$(location :metadata_runtime)"],
    data = [":foreign_runtime", ":metadata_runtime"],
    visibility = ["//visibility:public"],
)

# Relocatable bin/doxygen and bin/aspell for upstream metadata Makefiles.
alias(
    name = "metadata_runtime",
    actual = ":runtime",
    visibility = ["//visibility:public"],
)

exports_files(["configure_environment.sh"])

filegroup(
    name = "libtool_sources",
    srcs = glob(["tests/libtool/*"]),
)

configure_make(
    name = "libtool_fixture",
    lib_source = ":libtool_sources",
    configure_command = "configure.sh",
    configure_prefix = "/bin/sh",
    configure_in_place = True,
    features = ["-sanitize_pwd"],
    env = {
        "PATH": "$(execpath :foreign_runtime)/bin:$$PATH",
        "BAZEL_FOREIGN_TOOLS": "$(execpath :foreign_runtime)",
        "BAZEL_CONFIGURE_ENV": "$(execpath :configure_environment.sh)",
    },
    build_data = [":foreign_runtime", ":configure_environment.sh"],
    out_binaries = ["probe"],
    out_shared_libs = ["libprobe.so.0", "libcprobe.so.0"],
    out_data_files = ["config.log", "compiler-argv-validation.json"],
    postfix_script = "cp config.log compiler-argv-validation.json $$INSTALLDIR/",
)

select_file(name = "libtool_program", srcs = ":libtool_fixture", subpath = "libtool_fixture/bin/probe")
select_file(name = "libtool_library", srcs = ":libtool_fixture", subpath = "libtool_fixture/lib/libprobe.so.0")
select_file(name = "libtool_c_library", srcs = ":libtool_fixture", subpath = "libtool_fixture/lib/libcprobe.so.0")
select_file(name = "libtool_config", srcs = ":libtool_fixture", subpath = "libtool_fixture/config.log")
select_file(name = "libtool_argv_validation", srcs = ":libtool_fixture", subpath = "libtool_fixture/compiler-argv-validation.json")

py_test(
    name = "libtool_test",
    srcs = ["libtool_test.py"],
    args = ["$(location :libtool_program)", "$(location :libtool_library)", "$(location :libtool_c_library)", "$(location :libtool_config)", "$(location :libtool_argv_validation)"],
    data = [":libtool_program", ":libtool_library", ":libtool_c_library", ":libtool_config", ":libtool_argv_validation"],
    visibility = ["//visibility:public"],
)
