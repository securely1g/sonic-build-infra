load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")
load("@rules_python//python:defs.bzl", "py_test")
load(":defs.bzl", "build_tool", "build_tools_rootfs", "build_tools_runtime", "check_build_tools", "python_runtime")

python_runtime(name = "python_runtime", visibility = ["//visibility:public"])

cc_binary(
    name = "runtime_launcher",
    srcs = ["runtime_launcher.c"],
    # This C-only bootstrap must stay static when a foreign build selects Clang.
    # Pinned toolchains_llvm 1.11.2 names its default stdlib feature from the
    # generated local-<arch>-linux config; dynamic-stdc++-14 otherwise injects
    # libstdc++.so even for C. Disable that bundle only on this target. GCC
    # ignores these unknown disabled features; native GCC/Clang tests cover both.
    features = [
        "-local-aarch64-linux_nomsan_stdlib",
        "-local-x86_64-linux_nomsan_stdlib",
    ],
    linkopts = ["-static"],
    linkstatic = True,
)

py_test(
    name = "runtime_launcher_test",
    srcs = [
        "prepare_runtime.py",
        "runtime_launcher_test.py",
    ],
    args = ["$(location :runtime_launcher)"],
    data = [":runtime_launcher"],
    imports = ["."],
    main = "runtime_launcher_test.py",
    visibility = ["//visibility:public"],
)

# dpkg-shlibdeps needs the native runtime libraries' symbols/shlibs metadata and
# file ownership lists when packaging the source-built linux-kbuild programs.
_KERNEL_LINK_LIBRARIES = [
    "libc6",
    "libelf1t64",
    "libgcc-s1",
    "libssl3t64",
    "libzstd1",
    "zlib1g",
]

# One AMD64 runtime carries native tools and both target ABIs. Explicit
# architecture labels keep each library in its Debian multiarch directory.
_KERNEL_CROSS_SYSROOT = [
    "libc6",
    "libc6-dev",
    "libgcc-s1",
    "libcrypt1",
    "libcrypt-dev",
    "linux-libc-dev",
]

_KERNEL_CROSS_LIBRARIES = [
    "libelf-dev",
    "libelf1t64",
    "libssl-dev",
    "libssl3t64",
    "libzstd-dev",
    "libzstd1",
    "zlib1g-dev",
    "zlib1g",
]

_KERNEL_CROSS_ARCHITECTURES = ["arm64", "armhf"]

_KERNEL_CROSS_PACKAGES = [
    "@sysroot//" + name + "/" + architecture
    for architecture in _KERNEL_CROSS_ARCHITECTURES
    for name in _KERNEL_CROSS_SYSROOT
] + [
    "@build_tools//" + name + "/" + architecture
    for architecture in _KERNEL_CROSS_ARCHITECTURES
    for name in _KERNEL_CROSS_LIBRARIES
]

[
    build_tools_rootfs(
        name = "kernel_runtime_" + architecture,
        architecture = architecture,
        cross_architectures = _KERNEL_CROSS_ARCHITECTURES if architecture == "amd64" else [],
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        metadata_controls = ["@build_tools//" + name + ":control" for name in _KERNEL_LINK_LIBRARIES],
        metadata_data = ["@build_tools//" + name + ":data" for name in _KERNEL_LINK_LIBRARIES],
        packages = ["@build_tools"],
        target_controls = [label + ":control" for label in _KERNEL_CROSS_PACKAGES] if architecture == "amd64" else [],
        target_data = [label + ":data" for label in _KERNEL_CROSS_PACKAGES] if architecture == "amd64" else [],
    )
    for architecture, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

alias(
    name = "kernel_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":kernel_runtime_amd64",
        "@platforms//cpu:aarch64": ":kernel_runtime_arm64",
    }),
    visibility = ["//visibility:public"],
)

# Compatibility names resolve to the same tree; they do not assemble another
# runtime or choose a target architecture inside that tree.
[
    alias(
        name = "kernel_cross_runtime_" + architecture,
        actual = ":kernel_runtime_amd64",
        visibility = ["//visibility:public"],
    )
    for architecture in _KERNEL_CROSS_ARCHITECTURES
]

alias(
    name = "kernel_build_tools_arm64",
    actual = ":kernel_runtime",
    visibility = ["//visibility:public"],
)

alias(
    name = "kernel_build_tools_armhf",
    actual = ":kernel_runtime_amd64",
    visibility = ["//visibility:public"],
)

[
    py_test(
        name = "kernel_cross_runtime_" + architecture + "_test",
        srcs = ["kernel_cross_runtime_test.py"],
        args = [
            "$(location :kernel_runtime_amd64)",
            architecture,
        ],
        data = [":kernel_runtime_amd64"],
        main = "kernel_cross_runtime_test.py",
        tags = ["no-remote-exec"],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
    )
    for architecture in _KERNEL_CROSS_ARCHITECTURES
]


py_test(
