"""Generate binary Debian metadata with the source owner's declared inputs."""

DebianLibraryInfo = provider(fields = ["data", "control_tar", "symbols", "shlibs"])

def _library_impl(ctx):
    if not (ctx.file.control_tar or ctx.file.symbols or ctx.file.shlibs):
        fail("Declare a control archive, symbols or shlibs for this library")
    return [
        DefaultInfo(files = depset([ctx.file.data])),
        DebianLibraryInfo(
            data = ctx.file.data,
            control_tar = ctx.file.control_tar,
            symbols = ctx.file.symbols,
            shlibs = ctx.file.shlibs,
        ),
    ]

debian_library = rule(
    implementation = _library_impl,
    attrs = {
        "data": attr.label(allow_single_file = True, mandatory = True),
        "control_tar": attr.label(allow_single_file = True),
        "symbols": attr.label(allow_single_file = True),
        "shlibs": attr.label(allow_single_file = True),
    },
    doc = "Pair a target library payload with its owner's Debian ABI metadata.",
)

def _metadata_impl(ctx):
    architecture = None
    for cpu, name in [("x86_64", "amd64"), ("aarch64", "arm64"), ("armv7", "armhf")]:
        if ctx.target_platform_has_constraint(getattr(ctx.attr, "_" + cpu)[platform_common.ConstraintValueInfo]):
            architecture = name
    if not architecture:
        fail("Debian metadata requires an amd64, arm64 or armhf target")
    output = ctx.actions.declare_file(ctx.label.name + ".control")
    variables = ctx.actions.declare_file(ctx.label.name + ".substvars")
    receipt = ctx.actions.declare_file(ctx.label.name + ".json")
    symbols = ctx.actions.declare_file(ctx.label.name + ".symbols") if ctx.attr.generate_symbols else None
    inputs = [ctx.file.data, ctx.file.control, ctx.file.changelog]
    config = {
        "architecture": architecture,
        "package": ctx.attr.package,
        "version": ctx.attr.version,
        "data": ctx.file.data.path,
        "control": ctx.file.control.path,
        "changelog": ctx.file.changelog.path,
        "substitutions": ctx.attr.substitutions,
        "dependencies": [],
        "outputs": {"control": output.path, "substvars": variables.path, "receipt": receipt.path},
    }
    for name in ["symbols", "substvars"]:
        file = getattr(ctx.file, name)
        if file:
            inputs.append(file)
            config[name] = file.path
    if symbols:
        config["outputs"]["symbols"] = symbols.path
    for target in ctx.attr.dependencies:
        dependency = target[DebianLibraryInfo]
        row = {}
        for name in ["data", "control_tar", "symbols", "shlibs"]:
            file = getattr(dependency, name)
            if file:
                row[name] = file.path
                inputs.append(file)
        config["dependencies"].append(row)
    manifest = ctx.actions.declare_file(ctx.label.name + ".inputs.json")
    config["_generated"] = "AUTO-GENERATED by deb/metadata.bzl. DO NOT EDIT MANUALLY."
    ctx.actions.write(manifest, json.encode_indent(config) + "\n")
    tar = ctx.toolchains["@tar.bzl//tar/toolchain:type"]
    args = ctx.actions.args()
    args.add("--manifest", manifest)
    args.add("--tar", tar.tarinfo.binary)
    args.add("--gencontrol", ctx.executable._gencontrol)
    args.add("--shlibdeps", ctx.executable._shlibdeps)
    args.add("--gensymbols", ctx.executable._gensymbols)
    outputs = [output, variables, receipt] + ([symbols] if symbols else [])
    ctx.actions.run(
        executable = ctx.executable._metadata,
        arguments = [args],
        inputs = depset(inputs + [manifest]),
        tools = [
            ctx.attr._gencontrol[DefaultInfo].files_to_run,
            ctx.attr._shlibdeps[DefaultInfo].files_to_run,
            ctx.attr._gensymbols[DefaultInfo].files_to_run,
        ] + tar.default.files.to_list(),
        outputs = outputs,
        env = {"LANG": "C", "LC_ALL": "C", "PYTHONHASHSEED": "0"},
        mnemonic = "DebianMetadata",
        progress_message = "Generating Debian metadata for " + ctx.attr.package,
    )
    providers = [
        DefaultInfo(files = depset([output])),
        OutputGroupInfo(substvars = depset([variables]), receipt = depset([receipt]), symbols = depset([symbols] if symbols else [])),
    ]
    if symbols:
        providers.append(DebianLibraryInfo(data = ctx.file.data, symbols = symbols, control_tar = None, shlibs = None))
    return providers

debian_metadata = rule(
    implementation = _metadata_impl,
    attrs = {
        "data": attr.label(allow_single_file = True, mandatory = True),
        "control": attr.label(allow_single_file = True, mandatory = True),
        "changelog": attr.label(allow_single_file = True, mandatory = True),
        "package": attr.string(mandatory = True),
        "version": attr.string(),
        "dependencies": attr.label_list(providers = [DebianLibraryInfo]),
        "substitutions": attr.string_dict(),
        "substvars": attr.label(allow_single_file = True),
        "symbols": attr.label(allow_single_file = True),
        "generate_symbols": attr.bool(default = False),
        "_metadata": attr.label(default = Label(":metadata"), executable = True, cfg = "exec"),
        "_gencontrol": attr.label(default = Label("//tools/build_tools:dpkg-gencontrol"), executable = True, cfg = "exec"),
        "_shlibdeps": attr.label(default = Label("//tools/build_tools:dpkg-shlibdeps"), executable = True, cfg = "exec"),
        "_gensymbols": attr.label(default = Label("//tools/build_tools:dpkg-gensymbols"), executable = True, cfg = "exec"),
        "_x86_64": attr.label(default = Label("@platforms//cpu:x86_64")),
        "_aarch64": attr.label(default = Label("@platforms//cpu:aarch64")),
        "_armv7": attr.label(default = Label("@platforms//cpu:armv7")),
    },
    toolchains = ["@tar.bzl//tar/toolchain:type"],
    doc = "Derive control/substvars and optional symbols from actual packaged ELF files.",
)
