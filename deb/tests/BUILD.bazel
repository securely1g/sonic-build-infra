load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python:py_test.bzl", "py_test")
load("@tar.bzl", "tar")
load("//deb:metadata.bzl", "debian_library", "debian_metadata")
load("//deb:sonic_deb.bzl", "sonic_deb")
load(":filename_test.bzl", "filename_test")

package(default_visibility = ["//visibility:public"])

write_file(
    name = "binary_control",
    out = "binary.control",
    content = [
        "Package: sonic-example",
        "Version: 1:1.0-1",
        "Maintainer: SONiC maintainers <sonic-dev@lists.sonicfoundation.dev>",
        "Depends: libc6 (>= 2.41)",
        "Multi-Arch: same",
        "Description: Test package metadata",
    ] + select({
        "@platforms//cpu:x86_64": ["Architecture: amd64"],
        "@platforms//cpu:aarch64": ["Architecture: arm64"],
        "@platforms//cpu:armv7": ["Architecture: armhf"],
    }) + [""],
)

tar(
    name = "payload",
    srcs = ["example.conf"],
    mtree = [
        ". uid=0 gid=0 time=0 mode=0755 type=dir",
        "./etc uid=0 gid=0 time=0 mode=0755 type=dir",
        "./etc/example.conf uid=0 gid=0 time=0 mode=0644 type=file content=$(location example.conf)",
    ],
)

sonic_deb(
    name = "example_deb",
    control_file = ":binary_control",
    control_files = {
        "conffiles": "conffiles",
        "postinst": "postinst",
        "triggers": "triggers",
    },
    data = ":payload",
    package = "sonic-example",
    tags = ["manual"],
    version = "1:1.0-1",
    visibility = ["//deb/tests:__pkg__"],
)

# This checks only the control TAR; it never executes the DEB assembly action.
py_test(
    name = "control_archive_test",
    srcs = ["control_archive_test.py"],
    args = ["$(rootpath :example_deb_control)"],
    data = [":example_deb_control"],
)

debian_library(
    name = "libc",
    control_tar = "@build_tools//libc6:control",
    data = "@build_tools//libc6:data",
)

tar(
    name = "library_data",
    srcs = ["//tools/build_tools:libmetadata_probe.so"],
    mtree = [
        "usr/lib type=dir mode=0755 uid=0 gid=0",
        "usr/lib/libmetadata-probe.so.1 type=file mode=0644 uid=0 gid=0 content=$(location //tools/build_tools:libmetadata_probe.so)",
    ],
)

debian_metadata(
    name = "library_metadata",
    changelog = "changelog",
    control = "control",
    data = ":library_data",
    dependencies = [":libc"],
    generate_symbols = True,
    package = "libmetadata-probe1",
)

cc_import(
    name = "library",
    shared_library = "//tools/build_tools:libmetadata_probe.so",
)

cc_binary(
    name = "consumer",
    srcs = ["consumer.c"],
    deps = [":library"],
)

tar(
    name = "binary_data",
    srcs = [":consumer"],
    mtree = [
        "usr/bin type=dir mode=0755 uid=0 gid=0",
        "usr/bin/metadata-probe type=file mode=0755 uid=0 gid=0 content=$(location :consumer)",
    ],
)

debian_metadata(
    name = "binary_metadata",
    changelog = "changelog",
    control = "control",
    data = ":binary_data",
    dependencies = [
        ":libc",
        ":library_metadata",
    ],
    package = "metadata-probe",
    substitutions = {"misc:Depends": ""},
    version = "2:1.2.3-4+sonic.1",
)

filegroup(
    name = "symbols",
    srcs = [":library_metadata"],
    output_group = "symbols",
)

filegroup(
    name = "receipt",
    srcs = [":binary_metadata"],
    output_group = "receipt",
)

py_test(
    name = "metadata_test",
    srcs = ["metadata_test.py"],
    args = [
        "$(location :binary_metadata)",
        "$(location :library_metadata)",
        "$(location :symbols)",
        "$(location :receipt)",
    ],
    data = [
        ":binary_metadata",
        ":library_metadata",
        ":receipt",
        ":symbols",
    ],
)

filename_test(
    name = "filename_test",
    target_under_test = ":example_deb",
)
