load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@sonic_wheel_pip//:requirements.bzl", "requirement")
load("//python:site_packages.bzl", "site_packages")
load("//python:source_package.bzl", "python_runtime_packages")
load(":site_packages_contract.bzl", "demo_targets")

package(default_testonly = True)

demo_targets(name = "demo")

write_file(
    name = "generated_data",
    out = "site_demo/generated.txt",
    content = ["generated package data", ""],
)

py_library(
    name = "demo_library",
    srcs = [
        "site_demo/__init__.py",
        "site_demo/cli.py",
    ],
    data = ["site_demo/default.json", ":generated_data"],
    imports = ["."],
)

site_packages(
    name = "leaf",
    data_prefix = "/opt/runtime",
    distribution = "leaf-package",
    headers = "/opt/runtime/include",
    interpreter = "/usr/bin/python3",
    scripts = "/opt/runtime/bin",
    site_packages = "/opt/runtime/site",
    version = "1.3",
)

site_packages(
    name = "root",
    data_prefix = "/opt/runtime",
    distribution = "root-package",
    headers = "/opt/runtime/include",
    interpreter = "/usr/bin/python3",
    requires = [
        "site-demo[metrics]>=2.4",
        "leaf-package>=1.0",
    ],
    scripts = "/opt/runtime/bin",
    site_packages = "/opt/runtime/site",
    version = "4.0",
    runtime_deps = [
        ":demo",
        ":leaf",
    ],
)

python_runtime_packages(
    name = "image_packages",
    deps = [":root"],
)

filegroup(
    name = "image_metadata",
    srcs = [":image_packages"],
    output_group = "metadata",
)

py_test(
    name = "site_packages_test",
    srcs = ["site_packages_test.py"],
    args = [
        "--demo",
        "$(location :demo)",
        "--wheel",
        "$(location :demo_wheel)",
        "--tars",
        "$(locations :image_packages)",
        "--metadata",
        "$(locations :image_metadata)",
    ],
    data = [
        ":demo",
        ":demo_wheel",
        ":image_metadata",
        ":image_packages",
    ],
    python_version = "3.11",
)

py_test(
    name = "source_package_builder_test",
    srcs = ["source_package_builder_test.py"],
    python_version = "3.11",
    deps = [
        "//python:source_package_lib",
        requirement("installer"),
    ],
)

# Preserve the existing source-only API while distributions adopt explicit metadata.
site_packages(
    name = "legacy",
    srcs = [":demo_library"],
)

py_test(
    name = "runtime_lock_test",
    srcs = ["runtime_lock_test.py"],
    python_version = "3.11",
    deps = ["//python:runtime_lock_lib"],
)

exports_files(["runtime_lock_update_test.py"])

py_library(
    name = "runtime_lock_test_support",
    srcs = ["runtime_lock_test.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = ["//python:runtime_lock_lib"],
)
