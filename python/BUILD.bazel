# Python rules for native extensions & container images.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@sonic_wheel_pip//:requirements.bzl", "requirement")

exports_files(["wheel_requirements_lock.txt"])

py_binary(
    name = "wheel_layer_builder",
    srcs = ["wheel_layer_builder.py"],
    python_version = "3.11",
    visibility = ["//visibility:public"],
    deps = [requirement("installer")],
)

py_test(
    name = "wheel_layer_test",
    srcs = [
        "wheel_layer_builder.py",
        "wheel_layer_test.py",
    ],
    imports = ["."],
    python_version = "3.11",
    deps = [requirement("installer")],
)
