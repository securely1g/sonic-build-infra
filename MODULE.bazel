# Bookworm's original XS generators execute Perl 5.36, independently of target ABI.
apt_bookworm.install(
    dependency_set = "bookworm_perl_tools",
    packages = ["perl", "perl-base", "perl-modules-5.36", "libperl-dev"],
    suites = ["bookworm", "bookworm-updates", "bookworm-security"],
    include_transitive = True,
)
use_repo(apt_bookworm, "bookworm_perl_tools")

# Target-side debug symbols must match the selected target loader, not exec tools.
apt_bookworm.install(
    dependency_set = "bookworm_target_debug",
    packages = ["libc6-dbg"],
    suites = ["bookworm", "bookworm-updates", "bookworm-security"],
    include_transitive = True,
)
use_repo(apt_bookworm, "bookworm_target_debug")

# Bookworm normal-check instrumentation preserves the original builder tool suite.
apt_bookworm.install(
    dependency_set = "bookworm_test_tools",
    packages = ["valgrind", "libc6-dbg", "tcl8.6", "tcl-expect"],
    suites = ["bookworm", "bookworm-updates", "bookworm-security"],
    include_transitive = True,
)
use_repo(apt_bookworm, "bookworm_test_tools")

