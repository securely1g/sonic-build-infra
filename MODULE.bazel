        "cpp-12:amd64 (= 12.2.0-14+deb12u1)",
        "cpp-12:arm64 (= 12.2.0-14+deb12u1)",
        "cpp-12-aarch64-linux-gnu:amd64 (= 12.2.0-14cross1)",
        "g++-12:amd64 (= 12.2.0-14+deb12u1)",
        "g++-12:arm64 (= 12.2.0-14+deb12u1)",
        "g++-12-aarch64-linux-gnu:amd64 (= 12.2.0-14cross1)",
        "gcc-12:amd64 (= 12.2.0-14+deb12u1)",
        "gcc-12:arm64 (= 12.2.0-14+deb12u1)",
        "gcc-12-aarch64-linux-gnu:amd64 (= 12.2.0-14cross1)",
