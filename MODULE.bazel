# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
module(
    name = "sonic-build-infra",
    version = "0.0.33",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "swig", version = "4.3.0.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
# Preserve complete source-install/wheel metadata and explicit payload modes.
bazel_dep(name = "rules_python", version = "1.9.0.sonic.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.2")

sysroot_tar = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(sysroot_tar, "bsd_tar_toolchains_linux_amd64", "bsd_tar_toolchains_linux_arm64")

# Root builds must select the patch even when another dependency requests the
# upstream release, which sorts above its SONiC prerelease version.
single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "aspect_rules_py", version = "1.11.2")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
bazel_dep(name = "gawk", version = "5.3.2.sonic.1")

# A local module providing a cc_binary in a separate module, used only by our
# tests to prove that we correctly package binaries from another module.
bazel_dep(name = "deploy_tar_external_binary", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "deploy_tar_external_binary",
    path = "tests/external_binary_module",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# The SONiC patch sorts above upstream 0.9.4 without a root override.
# Share the prepared APT graph across dependency sets in the module lock.
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.18")

# One multiarch directory shared by GCC and Clang on both architectures.
# Consumers import this same repository through use_extension/use_repo.
sysroots = use_extension("//toolchains/sysroot:extensions.bzl", "sysroots")
sysroots.debian(name = "sonic_sysroot")
use_repo(sysroots, "sonic_sysroot")

gcc = use_extension("//toolchains/gcc:extensions.bzl", "gcc")
use_repo(
    gcc,
    "gcc-14.2.0-linux-target-aarch64-host-aarch64",
    "gcc-14.2.0-linux-target-aarch64-host-x86_64",
    "gcc-14.2.0-linux-target-x86_64-host-x86_64",
    "gcc_toolchains",
)

# Architectures with native build tools and general C/C++ toolchain setup.
NATIVE_ARCHITECTURES = [
    "amd64",
    "arm64",
]

# Kernel builds also target ARMHF using the AMD64 cross tools.
KERNEL_TARGET_ARCHITECTURES = NATIVE_ARCHITECTURES + ["armhf"]

# Every toolchain the gcc.debian_toolchain() tags below declare,
# one cc and one binutils toolchain per tag.
register_toolchains("@gcc_toolchains//:all")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

# One immutable reviewed package graph serves payloads, libraries and exec tools.
apt.sources_file(file = "//apt:sources.json")
apt.import_lock(
    libraries = True,
    lock = "//apt:apt.lock.json",
    requests = "//apt:requests.json",
    sources = "//apt:sources.json",
)

# Registered native owners still use this historical Bookworm namespace. Bind
# their library views to the same production lock rather than resolving again.
bookworm_apt = use_extension("//toolchains/bookworm:apt.bzl", "apt")
bookworm_apt.import_lock(
    dependency_sets = ["libnl_bookworm_system", "libyang_system_bookworm"],
    libraries = True,
    lock = "//apt:apt.lock.json",
    requests = "//apt:requests.json",
    sources = "//apt:sources.json",
)
use_repo(bookworm_apt, "libnl_bookworm_system", "libyang_system_bookworm")

# Preserve historical raw-archive interfaces from the same locked packages.
use_repo(
    apt,
    build_make_amd64 = "trixie_make-amd64_4.4.1-2",
    build_make_arm64 = "trixie_make-arm64_4.4.1-2",
    vim_amd64 = "trixie_vim-amd64_2-9.1.1230-2",
    vim_arm64 = "trixie_vim-arm64_2-9.1.1230-2",
    vim_runtime = "trixie_vim-runtime-amd64_2-9.1.1230-2",
)

# Shared collection requests and source inputs are declared in apt/requests.json.
use_repo(
    apt,
    # Re-export the hub repo, so that dependents on sonic-build-infra can get the whole central list
    # without having to declare their own dependencies.
    #
    # Dependents can use it by importing `sonic-build-infra` and loading it:
    #     apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
    #     use_repo(apt, "trixie")
    "trixie",

    # The cc toolchains' sysroot, resolved per architecture.
    "sysroot",

    # Build tools and their runtime dependencies, resolved per architecture.
    "build_tools",
    "image_tools",
    "initramfs_runtime",
    "manual_tools",
    "base_debug_debian",
    "frr_deps",
)

# The installer worker selects its own closure from the same locked set. These
# names include the worker's Debian requests and Docker CE's nftables dependency.
apt_inputs = use_repo_rule("//apt:inputs_repository.bzl", "apt_inputs")

apt_inputs(
    name = "installer_worker_apt_inputs",
    architecture = "amd64",
    dependency_set = "build_tools",
    lock = "//apt:apt.lock.json",
    root_packages = [
        "acl",
        "autoconf",
        "automake",
        "binutils",
        "build-essential",
        "busybox",
        "ca-certificates",
        "curl",
        "diffutils",
        "file",
        "findutils",
        "gawk",
        "git",
        "grep",
        "gzip",
        "iproute2",
        "iptables",
        "j2cli",
        "jq",
        "kmod",
        "libtool",
        "make",
        "mount",
        "nftables",
        "passwd",
        "pigz",
        "pkg-config",
        "procps",
        "psmisc",
        "python3",
        "sed",
        "squashfs-tools",
        "sudo",
        "tar",
        "unzip",
        "util-linux",
        "wget",
        "xz-utils",
        "zip",
        "zstd",
    ],
)

# Raw APT source archives used to assemble the shared compiler sysroots.
#
# Import these repositories for //toolchains/sysroot:packages.bzl; compilers
# consume the combined sysroot rather than individual package directories.
#
# Will fail loudly if the versions get out of sync.
SYSROOT_PACKAGE_REPO_TEMPLATES = [
    "trixie-security_linux-libc-dev-{arch}_6.12.96-1",
    "trixie_libc6-{arch}_2.41-12-deb13u3",
    "trixie_libc6-dev-{arch}_2.41-12-deb13u3",
    "trixie_libgcc-14-dev-{arch}_14.2.0-19",
    "trixie_libgcc-s1-{arch}_14.2.0-19",
    "trixie_libstdc---14-dev-{arch}_14.2.0-19",
    "trixie_libstdc--6-{arch}_14.2.0-19",
] + [
    "trixie_" + package + "-{arch}_14.2.0-19"
    for package in [
        "gcc-14-base",
        "libasan8",
        "libatomic1",
        "libgomp1",
        "libhwasan0",
        "libitm1",
        "liblsan0",
        "libtsan2",
        "libubsan1",
    ]
]

[
    [
        use_repo(apt, repo_template.format(arch = arch))
        for repo_template in SYSROOT_PACKAGE_REPO_TEMPLATES
    ]
    for arch in NATIVE_ARCHITECTURES
]

use_repo(apt, "trixie_libquadmath0-amd64_14.2.0-19")

# Check is a development package without the conventional -dev suffix. Export
# its pkg-config-selected archive through //apt/check:check from the shared lock.
use_repo(
    apt,
    check_amd64 = "trixie_check-amd64_0.15.2-3",
    check_arm64 = "trixie_check-arm64_0.15.2-3",
)

# Debian compiler executables and the libraries needed to run them. Native
# AMD64, native ARM64 and AMD64-to-ARM64 builds use the same package snapshot.
# Target headers and libraries remain in the shared sonic_sysroot repository.
GCC_RUNTIME_PACKAGES = {
    "binutils-common": "2.44-3",
    "gcc-14-base": "14.2.0-19",
    "libc6": "2.41-12+deb13u3",
    "libgcc-s1": "14.2.0-19",
    "libstdc++6": "14.2.0-19",
    "libcc1-0": "14.2.0-19",
    "libgmp10": "2:6.3.0+dfsg-3",
    "libmpfr6": "4.2.2-1",
    "libmpc3": "1.3.1-1+b3",
    "libisl23": "0.27-1",
    "libzstd1": "1.5.7+dfsg-1",
    "zlib1g": "1:1.3.dfsg+really1.3.1-1+b1",
    "libjansson4": "2.14-2+b3",
    "libsframe1": "2.44-3",
}

GCC_RUNTIME_REPOS = {
    arch: {
        name: "trixie_" + name.replace("+", "-") + "-" + arch + "_" + version.replace("+", "-").replace(":", "-")
        for name, version in GCC_RUNTIME_PACKAGES.items()
    }
    for arch in NATIVE_ARCHITECTURES
}

[
    use_repo(apt, repo)
    for repos in GCC_RUNTIME_REPOS.values()
    for name, repo in repos.items()
    # These packages were already imported for the shared sysroot above.
    if name not in [
        "gcc-14-base",
        "libc6",
        "libgcc-s1",
        "libstdc++6",
    ]
]

NATIVE_GCC_PLATFORMS = {
    "amd64": {
        "cpu": "x86_64",
        # Debian package names use x86-64; executable names use x86_64.
        "package_prefix": "x86-64-linux-gnu",
        "tool_prefix": "x86_64-linux-gnu",
    },
    "arm64": {
        "cpu": "aarch64",
        "package_prefix": "aarch64-linux-gnu",
        "tool_prefix": "aarch64-linux-gnu",
    },
}

NATIVE_GCC_PACKAGES = {
    arch: {
        "gcc-14-" + platform["package_prefix"]: "14.2.0-19",
        "g++-14-" + platform["package_prefix"]: "14.2.0-19",
        "cpp-14-" + platform["package_prefix"]: "14.2.0-19",
        "binutils-" + platform["package_prefix"]: "2.44-3",
        # Native binutils keep these libraries in separate packages; the
        # cross binutils package carries its own copies for its target.
        "libbinutils": "2.44-3",
        "libctf0": "2.44-3",
        "libctf-nobfd0": "2.44-3",
    }
    for arch, platform in NATIVE_GCC_PLATFORMS.items()
}

NATIVE_GCC_REPOS = {
    arch: [
        "trixie_" + name.replace("+", "-") + "-" + arch + "_" + version
        for name, version in packages.items()
    ]
    for arch, packages in NATIVE_GCC_PACKAGES.items()
}

[
    use_repo(apt, repo)
    for repos in NATIVE_GCC_REPOS.values()
    for repo in repos
]

[
    gcc.debian_toolchain(
        arch = platform["cpu"],
        debian_packages = [
            "@" + repo + "//:data.tar.xz"
            for repo in NATIVE_GCC_REPOS[arch] + GCC_RUNTIME_REPOS[arch].values()
        ],
        suite = "trixie",
        sysroot = "@sonic_sysroot//root:sysroot",
        target_platform = "//platforms:trixie",
        tool_prefix = platform["tool_prefix"],
        version = "14.2.0",
    )
    for arch, platform in NATIVE_GCC_PLATFORMS.items()
]

CROSS_GCC_PACKAGES = {
    "gcc-14-aarch64-linux-gnu": "14.2.0-19cross1",
    "g++-14-aarch64-linux-gnu": "14.2.0-19cross1",
    "cpp-14-aarch64-linux-gnu": "14.2.0-19cross1",
    "gcc-14-aarch64-linux-gnu-base": "14.2.0-19cross1",
    "binutils-aarch64-linux-gnu": "2.44-3",
}

CROSS_GCC_REPOS = [
    "trixie_" + name.replace("+", "-") + "-amd64_" + version
    for name, version in CROSS_GCC_PACKAGES.items()
]

[use_repo(apt, repo) for repo in CROSS_GCC_REPOS]

gcc.debian_toolchain(
    arch = "aarch64",
    debian_packages = [
        "@" + repo + "//:data.tar.xz"
        for repo in CROSS_GCC_REPOS + GCC_RUNTIME_REPOS["amd64"].values()
    ],
    exec_arch = "x86_64",
    suite = "trixie",
    sysroot = "@sonic_sysroot//root:sysroot",
    target_platform = "//platforms:trixie",
    tool_prefix = "aarch64-linux-gnu",
    version = "14.2.0",
)

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(
    hub_name = "pypi",
)
uv.project(
    default_build_dependencies = [
        "build",
        "setuptools",
    ],
    hub_name = "pypi",
    lock = "//deps:uv.lock",
    pyproject = "//deps:pyproject.toml",
)
use_repo(uv, "pypi")

# Provision both pip runtimes. This default applies only when infrastructure is
# the root module; image consumers keep the Python version chosen by their root.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(python_version = "3.11")
python.toolchain(python_version = "3.13")

# Installation tools run on the execution platform. The installer wheel is pure
# Python; its resolver version does not select the target image's Python ABI.
wheel_pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
wheel_pip.parse(
    hub_name = "sonic_wheel_pip",
    python_version = "3.11",
    requirements_lock = "//python:wheel_requirements_lock.txt",
)
use_repo(wheel_pip, "sonic_wheel_pip")

# Share Debian parsing across the infrastructure and image Python runtimes.
[
    wheel_pip.parse(
        hub_name = "sonic_apt_pip",
        python_version = version,
        requirements_lock = "//apt:requirements_lock.txt",
    )
    for version in [
        "3.11",
        "3.13",
    ]
]

use_repo(wheel_pip, "sonic_apt_pip")

# Declared execution tools for upstream configure/Make source builds.
register_toolchains(
    "//tools/build_tools:make_toolchain",
    "//tools/build_tools:m4_toolchain",
    "//tools/build_tools:pkgconfig_toolchain",
    "//tools/build_tools:autoconf_toolchain",
)

# Tests use the consuming root's selected Go SDK. The development SDK below
# registers the same reviewed version for standalone infrastructure tests.
bazel_dep(name = "rules_go", version = "0.64.1", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(
    name = "go_sdk",
    version = "1.26.7",
)
use_repo(go_sdk, "go_sdk")

# Cargo is selected from the execution platform's Rust SDK. Consumers register
# their own SDK; this development toolchain serves standalone infrastructure tests.
bazel_dep(name = "rules_rs", version = "0.1.0")

rust_rules = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rust_rules, "rules_rust")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

# Bazel 8.5.1 uses the compatible rules_cc API also selected by buildimage.
single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

register_toolchains("//tools/build_tools:gawk_toolchain")

bookworm_bazel_lib_tools = use_extension("@bazel_lib//lib:extensions.bzl", "toolchains")
use_repo(bookworm_bazel_lib_tools, "coreutils_toolchains", "zstd_toolchains")

use_repo(sysroot_tar, "bsd_tar_toolchains")

