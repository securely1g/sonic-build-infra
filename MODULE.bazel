    urls = [DEBIAN_SNAPSHOT + "/pool/main/m/make-dfsg/make_4.4.1-2_arm64.deb"],
)

bookworm_bazel_lib_tools = use_extension("@bazel_lib//lib:extensions.bzl", "toolchains")
use_repo(bookworm_bazel_lib_tools, "coreutils_toolchains", "zstd_toolchains")

use_repo(sysroot_tar, "bsd_tar_toolchains")

