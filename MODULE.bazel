# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
module(
    name = "sonic-build-infra",
    version = "0.0.6",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "swig", version = "4.3.0.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "aspect_rules_py", version = "1.11.2")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")

# A local module providing a cc_binary in a separate module, used only by our
# tests to prove that we correctly package binaries from another module.
bazel_dep(name = "deploy_tar_external_binary", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "deploy_tar_external_binary",
    path = "tests/external_binary_module",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "rules_distroless", version = "0.0.0.commit-01bb79d7eef4eb3ce9511d3dfaf0ab386bd8d12d")

GCC_TOOLCHAINS = {
    "14.2.0": {
        "release": "20-08-2026",
        "suite": "trixie",
        "integrity": {
            "x86_64": "sha256-QcX9m+ftDHwwDe4YQ0lxtnq0VkO52B8xlgkk3HOulDc=",
            "aarch64": "sha256-mF+uzgBydl6AfMYmQTzpbQWh53gaqrluJaGtfznxRZ0=",
        },
    },
}

gcc = use_extension("//toolchains/gcc:extensions.bzl", "gcc")

[
    gcc.debian_toolchain(
        arch = arch,
        integrity = integrity,
        release = toolchain["release"],
        suite = toolchain["suite"],
        target_platform = "//platforms:trixie",
        version = version,
    )
    for version, toolchain in GCC_TOOLCHAINS.items()
    for arch, integrity in toolchain["integrity"].items()
]

use_repo(gcc, "gcc_toolchains")

ARCHITECTURES = [
    "amd64",
    "arm64",
]

# Every toolchain the gcc.debian_toolchain() tags above declare,
# one cc and one binutils toolchain per tag.
register_toolchains("@gcc_toolchains//:all")

DEBIAN_SNAPSHOT = "https://snapshot.debian.org/archive/debian/20260727T143429Z"

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ARCHITECTURES,
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    uris = [DEBIAN_SNAPSHOT],
)
apt.sources_list(
    architectures = ARCHITECTURES,
    components = ["main"],
    suites = ["trixie-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260726T121236Z"],
)

# The cc toolchains' sysroot: libc, libstdc++ and kernel headers.
# We keep it in a separate apt install set so that the toolchain can resolve
# without fetching the entire closure of packages.
apt.install(
    dependency_set = "sysroot",
    packages = [
        "libc6-dev",
        "libgcc-14-dev",
        "libstdc++-14-dev",
        "linux-libc-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
apt.install(
    dependency_set = "trixie",
    packages = [
        # do not sort
        # debug utilities
        "gdb",
        "gdbserver",
        # Needed for vim, though vim itself is fetched from the main buildimage,
        # because we can't resolve the right virtual package from rules_distroless yet.
        "libgpm2",
        "strace",
        "sshpass",
        "openssh-client",
        # openssh-client's shared libraries.
        # The FIPS OpenSSH deb ships without deps, so we fetch these from apt.
        "libedit2",
        "libfido2-1",

        # for sonic-swss-common
        # trixie ships libyang 3, so the -dev package lost its soversion suffix.
        "nlohmann-json3-dev",
        "libhiredis-dev",
        "libboost-dev",
        "libboost-serialization-dev",
        "uuid-dev",
        "libzmq3-dev",
        "libyang-dev",
        "swig",
        "python3-dev",

        # for docker-sysmgr
        "libdbus-1-3",
        "libdbus-c++-1-0v5",
        "libprotobuf32t64",

        # for sonic-sysmgr
        "libdbus-c++-bin",
        "libdbus-c++-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(
    apt,
    # Re-export the hub repo, so that dependents on sonic-build-infra can get the whole central list
    # without having to declare their own dependencies.
    #
    # Dependents can use it by importing `sonic-build-infra` and loading it:
    #     apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
    #     use_repo(apt, "trixie")
    "trixie",

    # The cc toolchains' sysroot, resolved per architecture.
    "sysroot",
)

# The `vim` .debs, because rules_distroless can't give us vim.
#
# `vim` is a virtual package that many packages provide, not just the one named `vim`.
# rules_distroless resolves a name to a virtual provider before it looks for a real package,
# so asking it for "vim" hands back vim-nox, which is a package with a bunch of extra
# language runtimes and different configuration.
# The Make build installs this concrete `vim` package, so we fetch those .debs directly
# and unpack them for //deps/vim:BUILD.bazel to assemble into layers.
# The reason why they're here instead of an `imported` file inside deps/vim is
# that we want to use DEBIAN_SNAPSHOT, and we can't import it without building a whole extension,
# which would be overkill.
#
# TODO(bazel-ready): drop all of this once rules_distroless prefers a real
# package over a virtual one of the same name.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_DEB_BUILD_FILE = """exports_files(["data.tar.xz"])"""

http_archive(
    name = "vim_amd64",
    build_file_content = _DEB_BUILD_FILE,
    sha256 = "7050d710bbcd5dee68865d90fd95a9aa865bf16d9a3874c5bb6a4f1d69231cfe",
    urls = [DEBIAN_SNAPSHOT + "/pool/main/v/vim/vim_9.1.1230-2_amd64.deb"],
)

http_archive(
    name = "vim_arm64",
    build_file_content = _DEB_BUILD_FILE,
    sha256 = "933d4a979a78574f3e57b0ddb87088c720a4526fdd254c39394c4b70f5e59aa7",
    urls = [DEBIAN_SNAPSHOT + "/pool/main/v/vim/vim_9.1.1230-2_arm64.deb"],
)

# vim-runtime is Architecture: all, so one copy serves every platform.
http_archive(
    name = "vim_runtime",
    build_file_content = _DEB_BUILD_FILE,
    sha256 = "5addd2e7d3aae7d1907aba6c0c16c525e78ccfc0f6ee9ef9651c139a80c97058",
    urls = [DEBIAN_SNAPSHOT + "/pool/main/v/vim/vim-runtime_9.1.1230-2_all.deb"],
)

# Raw apt package repos the cc toolchains reach into.
#
# We need to bring these packages into scope so that the gcc toolchains
# can refer to them to create their sysroots.
#
# Will fail loudly if the versions get out of sync.
SYSROOT_PACKAGE_REPO_TEMPLATES = [
    "trixie-security_linux-libc-dev-{arch}_6.12.96-1",
    "trixie_libc6-{arch}_2.41-12-deb13u3",
    "trixie_libc6-dev-{arch}_2.41-12-deb13u3",
    "trixie_libgcc-14-dev-{arch}_14.2.0-19",
    "trixie_libgcc-s1-{arch}_14.2.0-19",
    "trixie_libstdc---14-dev-{arch}_14.2.0-19",
    "trixie_libstdc--6-{arch}_14.2.0-19",
]

[
    [
        use_repo(apt, repo_template.format(arch = arch))
        for repo_template in SYSROOT_PACKAGE_REPO_TEMPLATES
    ]
    for arch in ARCHITECTURES
]

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(
    hub_name = "pypi",
)
uv.project(
    default_build_dependencies = [
        "build",
        "setuptools",
    ],
    hub_name = "pypi",
    lock = "//deps:uv.lock",
    pyproject = "//deps:pyproject.toml",
)
use_repo(uv, "pypi")
