# Debhelper dbgsym compression is an installation choice. Keep the original
# default and opt-in cases observable through the public TAR interface.
sonic_deploy_tar(
    name = "hello_debug_default",
    binaries = {"usr/bin/hello type=file uid=0 gid=0 mode=0755": ":hello_cpp"},
    force_debug_build = True,
)
sonic_deploy_tar(
    name = "hello_debug_compressed",
    binaries = {"usr/bin/hello type=file uid=0 gid=0 mode=0755": ":hello_cpp"},
    force_debug_build = True,
    compress_debug_sections = True,
)
py_test(
    name = "debug_compression_test",
    srcs = ["debug_compression_test.py"],
    args = ["$(location //toolchains/binutils:readelf)"] + [
        "$(location :hello_debug_" + mode + suffix + ")"
        for mode in ["default", "compressed"]
        for suffix in ["", ".debug_symbols"]
    ],
    data = ["//toolchains/binutils:readelf"] + [
        ":hello_debug_" + mode + suffix
        for mode in ["default", "compressed"]
        for suffix in ["", ".debug_symbols"]
    ],
)

# Exact installation paths replace all build and dependency search entries.
[
    sonic_deploy_tar(
        name = "hello_" + kind + "_exact_deployment",
        binaries = {"usr/bin/hello type=file uid=0 gid=0 mode=0755": ":hello_" + kind},
        install_rpath = "/opt/sonic/exact/lib",
        force_debug_build = True,
    )
    for kind in ["rpath", "runpath"]
]

[
    py_test(
        name = "hello_" + kind + "_exact_deployment_test",
        srcs = ["strip_rpath_test.py"],
        main = "strip_rpath_test.py",
        args = [
            "$(location //toolchains/binutils:readelf)",
            "$(location //toolchains/binutils:objcopy)",
            "$(location :hello_" + kind + ")",
            "$(location :hello_" + kind + "_exact_deployment)",
            "$(location :hello_" + kind + "_exact_deployment.debug_symbols)",
            kind.upper(),
            "exact=/opt/sonic/exact/lib",
            "archives",
        ],
        data = [
            "//toolchains/binutils:readelf",
            "//toolchains/binutils:objcopy",
            ":hello_" + kind,
            ":hello_" + kind + "_exact_deployment",
            ":hello_" + kind + "_exact_deployment.debug_symbols",
        ],
    )
    for kind in ["rpath", "runpath"]
]

# FRR installs private libraries outside ld.so.cache's standard directories.
# Its deployment RPATH must survive either base-image policy, with build paths
# filtered and the original dynamic tag/debug pairing preserved.
[
    strip_binary(
        name = "hello_" + kind + "_installation_split",
        src = ":hello_" + kind,
        force_debug_build = True,
        preserve_install_rpath = True,
    )
    for kind in ["rpath", "runpath"]
]

[
    filegroup(
        name = "hello_" + kind + "_installation_" + group,
        srcs = [":hello_" + kind + "_installation_split"],
        output_group = group,
    )
