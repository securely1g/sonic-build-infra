#########################
#   strip_binary tests  #
#########################

# Test that a C executable strips correctly.
cc_binary(
    name = "hello",
    srcs = ["//tests/testdata:hello.c"],
)

build_test(
    name = "hello_build_test",
    targets = [":hello"],
)

strip_binary(
    name = "hello_strip",
    src = ":hello",
    force_debug_build = True,
)

assert_stripped(
    name = "hello_strip_test",
    strip_target = ":hello_strip",
)

provides_debug_symbols_test(
    name = "hello_strip_provides_debug_symbols_test",
    target_under_test = ":hello_strip",
)

#############################
#   PIC support tests       #
#############################

assert_cc_toolchain_features_test(
    name = "cc_toolchain_supports_pic_test",
    enabled = ["supports_pic"],
)

# Same flow, but for a shared library (.so) via cc_binary(linkshared = True).
cc_binary(
    name = "libgreet.so",
    srcs = ["//tests/testdata:greet.c"],
    linkshared = True,
)

build_test(
    name = "libgreet_build_test",
    targets = [":libgreet.so"],
)

assert_position_independent(
    name = "libgreet_pic_test",
    library = ":libgreet.so",
)

keep_debug_info(
    name = "libgreet_debug",
    src = ":libgreet.so",
)

strip_binary(
    name = "libgreet_strip",
    src = ":libgreet_debug",
)

assert_stripped(
    name = "libgreet_strip_test",
    strip_target = ":libgreet_strip",
)

# Same flow again, but for a shared library built via cc_shared_library.
cc_library(
    name = "greet_lib",
    srcs = ["//tests/testdata:greet.c"],
)

cc_shared_library(
    name = "greet_shared",
    deps = [":greet_lib"],
)

build_test(
    name = "greet_shared_build_test",
    targets = [":greet_shared"],
)

assert_position_independent(
    name = "greet_shared_pic_test",
    library = ":greet_shared",
)

keep_debug_info(
    name = "greet_shared_debug",
    src = ":greet_shared",
)

strip_binary(
    name = "greet_shared_strip",
    src = ":greet_shared_debug",
)

assert_stripped(
    name = "greet_shared_strip_test",
    strip_target = ":greet_shared_strip",
)

#############################
#   sonic_deploy_tar tests  #
#############################

sonic_deploy_tar(
    name = "hello_deploy_tar",
    srcs = ["//tests/testdata:file.txt"],
    binaries = {
        "./usr/bin/hello uid=0 gid=0 time=1672560000 mode=0755 type=file": ":hello",
    },
    force_debug_build = True,
    mtree = [
        ". time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/bin uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share/file.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location //tests/testdata:file.txt)",
    ],
)

# Assert the tar has roughly the shape we expect
assert_tar(
    name = "hello_deploy_tar_assert",
    expected = ":hello_deploy_tar.expected.txt",
    inconsistent_sizes = ["./usr/bin/hello"],
    tar = ":hello_deploy_tar",
)

# Assert the packaged binary is the stripped version.
strip_binary(
    name = "hello_deploy_expected_strip",
    src = ":hello",
    force_debug_build = True,
)

filegroup(
    name = "hello_deploy_expected_stripped",
    testonly = True,
    srcs = [":hello_deploy_expected_strip"],
    output_group = "stripped",
)

genrule(
    name = "hello_deploy_extracted_hello",
    testonly = True,
    srcs = [":hello_deploy_tar"],
    outs = ["hello_deploy_extracted_hello.bin"],
    cmd = "$(BSDTAR_BIN) xOf $(execpath :hello_deploy_tar) ./usr/bin/hello > $@",
    toolchains = ["@tar.bzl//tar/toolchain:type"],
)

diff_test(
    name = "hello_deploy_tar_content_test",
    timeout = "short",
    file1 = ":hello_deploy_extracted_hello.bin",
    file2 = ":hello_deploy_expected_stripped",
)

# The debug tar lays the .debug out under /usr/lib/debug/.build-id/NN/REST.debug.
assert_tar(
    name = "hello_deploy_tar_debug_assert",
    expected = ":hello_deploy_tar_debug.expected.txt",
    tar = ":hello_deploy_tar.debug_symbols",
)

# The deploy tar target itself must carry DebugSymbolsInfo for the binaries it packages.
provides_debug_symbols_test(
    name = "hello_deploy_tar_provides_debug_symbols_test",
    target_under_test = ":hello_deploy_tar",
)

# Test that we can push through `flatten` targets.
flatten(
    name = "hello_runtime_layer",
    tars = [":hello_deploy_tar"],
)

debug_symbols_layer(
    name = "hello_collected_debug_symbols",
    image = ":hello_runtime_layer",
)

assert_tar(
    name = "hello_collected_debug_symbols_assert",
    expected = ":hello_deploy_tar_debug.expected.txt",
    tar = ":hello_collected_debug_symbols",
)

# Test that we can push through `base`.
image_stub(
    name = "hello_base_image",
    base = ":hello_deploy_tar",
)

debug_symbols_layer(
    name = "hello_base_collected_debug_symbols",
    image = ":hello_base_image",
)

assert_tar(
    name = "hello_base_collected_debug_symbols_assert",
    expected = ":hello_deploy_tar_debug.expected.txt",
    tar = ":hello_base_collected_debug_symbols",
)

# Test that we can work with binaries from a different module.
sonic_deploy_tar(
    name = "external_deploy_tar",
    binaries = {
        "./usr/bin/external_hello uid=0 gid=0 time=1672560000 mode=0755 type=file": "@deploy_tar_external_binary//:external_hello",
    },
    force_debug_build = True,
    mtree = [
        ". time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/bin uid=0 gid=0 time=946699200 mode=0755 type=dir",
    ],
)

build_test(
    name = "external_deploy_tar_build_test",
    targets = [
        ":external_deploy_tar",
        ":external_deploy_tar.debug_symbols",
    ],
)

#############################
#   sonic_deb tests         #
#############################

tar(
    name = "hello_deb_data",
    srcs = ["//tests/testdata:file.txt"],
    mtree = [
        ". time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share/hello uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share/hello/file.txt uid=0 gid=0 time=1672560000 mode=0644 type=file content=$(location //tests/testdata:file.txt)",
    ],
)

sonic_deb(
    name = "hello_deb",
    data = ":hello_deb_data",
    depends = ["libc6 (>= 2.34)"],
    description = "Hello test package",
    maintainer = "SONiC <sonic@example.com>",
    package = "hello",
    # There is no make-based target to compare against.
    tags = ["no-elf-equivalence"],
    version = "1.0",
)

build_test(
    name = "hello_deb_build_test",
    targets = [":hello_deb"],
)

assert_deb_members(
    name = "hello_deb_members_assert",
    deb = ":hello_deb",
    expected = ":hello_deb_members.expected.txt",
)

assert_deb_control(
    name = "hello_deb_control_assert",
    deb = ":hello_deb",
    expected = ":hello_deb_control.expected.txt",
)

assert_deb_md5sums(
    name = "hello_deb_md5sums_assert",
    deb = ":hello_deb",
    expected = ":hello_deb_md5sums.expected.txt",
)

# The -dbg package goes through the same data= path, fed by sonic_deploy_tar's
# `.debug_symbols` sibling. Its content (build-id-named .debug files) is not
# deterministic, so this is a build_test only.
sonic_deb(
    name = "hello_dbg_deb",
    data = ":hello_deploy_tar.debug_symbols",
    depends = ["hello (= 1.0)"],
    description = "Debug symbols for hello",
    maintainer = "SONiC <sonic@example.com>",
    package = "hello-dbg",
    # There is no make-based target to compare against.
    tags = ["no-elf-equivalence"],
    version = "1.0",
)

build_test(
    name = "hello_dbg_deb_build_test",
    targets = [":hello_dbg_deb"],
)
